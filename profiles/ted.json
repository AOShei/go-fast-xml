{
  "profile": "ted",
  "title": "TED public procurement notices before eForms (TED_EXPORT, schema R2.0.8 and R2.0.9)",
  "format": 1,
  "default_namespace": "http://publications.europa.eu/resource/schema/ted/R2.0.9/publication",
  "namespace_aliases": {
    "http://publications.europa.eu/resource/schema/ted/R2.0.8/publication": "http://publications.europa.eu/resource/schema/ted/R2.0.9/publication",
    "http://publications.europa.eu/TED_schema/Export": "http://publications.europa.eu/resource/schema/ted/R2.0.9/publication",
    "http://formex.publications.europa.eu/ted/schema/export/R2.0.9.S01.E01": "http://publications.europa.eu/resource/schema/ted/R2.0.9/publication"
  },
  "match": [
    {"root": "TED_EXPORT", "namespace": "http://publications.europa.eu/resource/schema/ted/R2.0.9/publication"},
    {"root": "TED_EXPORT", "namespace": "http://publications.europa.eu/resource/schema/ted/R2.0.8/publication"},
    {"root": "TED_EXPORT", "namespace": "http://publications.europa.eu/TED_schema/Export"},
    {"root": "TED_EXPORT", "namespace": "http://formex.publications.europa.eu/ted/schema/export/R2.0.9.S01.E01"}
  ],
  "heading_base": 1,
  "notes": "See profiles/ted.md. Each form of the notice (one per language it is published in) is a section whose heading is its LG attribute; in the 2014 forms the notice's title, each lot and each award are headings and their descriptions paragraphs. Everything else is tables of names and values, the name being the file's own element path; an element whose presence is the value (PT_OPEN) is a row with an empty value. Codes are as written.",
  "rules": [
    {"match": "/TED_EXPORT", "as": "transparent", "extra": {"ted.doc_id": {"attr": "DOC_ID"}, "ted.edition": {"attr": "EDITION"}, "ted.version": {"attr": "VERSION"}}},
    {"match": "/TED_EXPORT/*", "as": "table", "pairs": "path", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/CODED_DATA_SECTION", "as": "transparent"},
    {"match": "/TED_EXPORT/CODED_DATA_SECTION/*", "as": "table", "pairs": "path", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/TRANSLATION_SECTION", "as": "transparent"},
    {"match": "/TED_EXPORT/TRANSLATION_SECTION/*", "as": "table", "pairs": "path", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/TRANSLATION_SECTION/ML_TITLES", "as": "table", "header": ["language", "country", "town", "title"]},
    {"match": "ML_TITLES/ML_TI_DOC", "as": "row", "cells": [{"attr": "LG"}], "rest": 4},
    {"match": "ML_TI_DOC/TI_CY", "as": "cell", "column": 2},
    {"match": "ML_TI_DOC/TI_TOWN", "as": "cell", "column": 3},
    {"match": "ML_TI_DOC/TI_TEXT", "as": "transparent"},
    {"match": "/TED_EXPORT/TRANSLATION_SECTION/ML_AA_NAMES", "as": "table", "header": ["language", "name"]},
    {"match": "ML_AA_NAMES/AA_NAME", "as": "row", "cells": [{"attr": "LG"}], "rest": 2},

    {"match": "/TED_EXPORT/FORM_SECTION", "as": "transparent"},
    {"match": "/TED_EXPORT/FORM_SECTION/*", "as": "section", "heading": {"attr": "LG"}, "attrs": {"ted.form": {"attr": "FORM"}, "ted.category": {"attr": "CATEGORY"}, "ted.version": {"attr": "VERSION"}}},
    {"match": "/TED_EXPORT/FORM_SECTION/NOTICE_UUID", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "/TED_EXPORT/FORM_SECTION/*/*", "as": "table", "pairs": "path", "pairs_empty": true, "header": ["name", "value"]},

    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT", "as": "section", "attrs": {"ted.item": {"attr": "ITEM"}}},
    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT/TITLE", "as": "metadata", "field": "title", "also_heading": 2},
    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT/SHORT_DESCR", "as": "transparent", "mark": {"ted.field": "SHORT_DESCR"}},
    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT/OBJECT_DESCR", "as": "section", "attrs": {"ted.item": {"attr": "ITEM"}}},
    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT/OBJECT_DESCR/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT/OBJECT_DESCR/TITLE", "as": "heading", "level": 3},
    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT/OBJECT_DESCR/SHORT_DESCR", "as": "transparent", "mark": {"ted.field": "SHORT_DESCR"}},
    {"match": "/TED_EXPORT/FORM_SECTION/*/OBJECT_CONTRACT/OBJECT_DESCR/INFO_ADD", "as": "transparent", "mark": {"ted.field": "INFO_ADD"}},
    {"match": "/TED_EXPORT/FORM_SECTION/*/AWARD_CONTRACT", "as": "section", "attrs": {"ted.item": {"attr": "ITEM"}}},
    {"match": "/TED_EXPORT/FORM_SECTION/*/AWARD_CONTRACT/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/FORM_SECTION/*/AWARD_CONTRACT/TITLE", "as": "heading", "level": 3},
    {"match": "/TED_EXPORT/FORM_SECTION/*/COMPLEMENTARY_INFO", "as": "transparent"},
    {"match": "/TED_EXPORT/FORM_SECTION/*/COMPLEMENTARY_INFO/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/FORM_SECTION/*/COMPLEMENTARY_INFO/INFO_ADD", "as": "transparent", "mark": {"ted.field": "INFO_ADD"}},

    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT", "as": "transparent", "note": "notices written as text (other notices, corrigenda)"},
    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT/TI_DOC", "as": "heading", "level": 2},
    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT/STI_DOC", "as": "transparent", "mark": {"ted.field": "STI_DOC"}},
    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT/CONTENTS", "as": "transparent"},
    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT/CONTENTS/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT/CONTENTS/P", "as": "block", "kind": "paragraph"},
    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT/CONTENTS/GR_SEQ", "as": "section"},
    {"match": "/TED_EXPORT/FORM_SECTION/OTH_NOT/FD_OTH_NOT/CONTENTS/MARK_LIST", "as": "list", "ordered": false, "attrs": {"ted.sep": {"attr": "SEP"}}},
    {"match": "GR_SEQ", "as": "section"},
    {"match": "GR_SEQ/TI_GRSEQ", "as": "heading", "level": "nesting"},
    {"match": "BLK_BTX_SEQ", "as": "transparent"},
    {"match": "BLK_BTX", "as": "block", "kind": "paragraph"},
    {"match": "MARK_LIST", "as": "list", "ordered": false, "attrs": {"ted.sep": {"attr": "SEP"}}},
    {"match": "MLI_OCCUR", "as": "item", "attrs": {"ted.no_seq": {"attr": "NO_SEQ"}}},
    {"match": "MLI_OCCUR/NO_MARK", "as": "label"},
    {"match": "MLI_OCCUR/TI_MARK", "as": "block", "kind": "paragraph"},
    {"match": "MLI_OCCUR/TXT_MARK", "as": "transparent"},
    {"match": "ADDRESS_NOT_STRUCT", "as": "inline", "note": "an address written as a sentence, its parts tagged: read as the sentence"},
    {"match": "ADDRESS_NOT_STRUCT/*", "as": "inline", "space": true},
    {"match": "ADDRESS_NOT_STRUCT/BLK_BTX", "as": "inline"},
    {"match": "ADDRESS_NOT_STRUCT/COUNTRY", "as": "inline", "space": true, "value": {"attr": "VALUE"}},

    {"match": "P", "as": "block", "kind": "paragraph"},
    {"match": "FT", "as": "inline", "attrs": {"ted.type": {"attr": "TYPE"}}},
    {"match": "FT[@TYPE='SUP']", "as": "inline", "style": "superscript"},
    {"match": "FT[@TYPE='SUB']", "as": "inline", "style": "subscript"}
  ]
}
