{
  "profile": "tei",
  "title": "TEI P5 (Text Encoding Initiative): texts, drama, verse, editions, manuscript descriptions, dictionaries",
  "format": 1,
  "default_namespace": "http://www.tei-c.org/ns/1.0",
  "namespaces": {"tei": "http://www.tei-c.org/ns/1.0"},
