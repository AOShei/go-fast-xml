{
  "profile": "xliff",
  "title": "XLIFF 1.0 to 1.2, XML Localisation Interchange File Format (OASIS), with SDL XLIFF and memoQ files",
  "format": 1,
  "namespaces": {
    "sdl": "http://sdl.com/FileTypes/SdlXliff/1.0"
  },
  "namespace_aliases": {
    "urn:oasis:names:tc:xliff:document:1.2": "",
    "urn:oasis:names:tc:xliff:document:1.1": ""
  },
  "match": [
    {"root": "xliff", "namespace": "urn:oasis:names:tc:xliff:document:1.2"},
    {"root": "xliff", "namespace": "urn:oasis:names:tc:xliff:document:1.1"},
    {"root": "xliff", "attr": "[@version='1.0']"},
    {"root": "xliff", "attr": "[@version='1.1']"},
    {"root": "xliff", "attr": "[@version='1.2']"}
  ],
  "heading_base": 1,
  "notes": "See profiles/xliff.md. One section and one table per file, a row per trans-unit (RowLocs, anchor id).",
  "rules": [
    {"match": "/xliff", "as": "transparent", "extra": {"xliff.version": {"attr": "version"}}},
    {"match": "/xliff/file", "as": "section", "anchor": {"attr": "id"}, "mark": {
      "xliff.original": {"attr": "original"}, "xliff.source_language": {"attr": "source-language"},
      "xliff.target_language": {"attr": "target-language"}, "xliff.datatype": {"attr": "datatype"},
      "xliff.tool": {"attr": "tool"}, "xliff.date": {"attr": "date"}, "xliff.category": {"attr": "category"},
      "xliff.product_name": {"attr": "product-name"}, "xliff.product_version": {"attr": "product-version"},
      "xliff.build_num": {"attr": "build-num"}}},
    {"match": "file/header", "as": "transparent"},
    {"match": "header/note", "as": "block", "kind": "paragraph", "attrs": {"xliff.field": "note", "xliff.from": {"attr": "from"}, "xliff.priority": {"attr": "priority"}, "xliff.annotates": {"attr": "annotates"}}},
    {"match": "header/tool", "as": "block", "kind": "paragraph", "value": {"attr": "tool-name"}, "attrs": {"xliff.field": "tool", "xliff.tool_id": {"attr": "tool-id"}, "xliff.tool_version": {"attr": "tool-version"}, "xliff.tool_company": {"attr": "tool-company"}}},
    {"match": "header/phase-group", "as": "table", "attrs": {"xliff.field": "phase-group"}},
    {"match": "phase-group/phase", "as": "row", "cells": [{"attr": "phase-name"}, {"attr": "process-name"}, {"attr": "company-name"}, {"attr": "tool-id"}, {"attr": "date"}, {"attr": "job-id"}, {"attr": "contact-name"}, {"attr": "contact-email"}, {"attr": "contact-phone"}], "rest": 10},
    {"match": "header/count-group", "as": "transparent", "mark": {"xliff.count_group": {"attr": "name"}}},
    {"match": "count", "as": "block", "kind": "paragraph", "attrs": {"xliff.field": "count", "xliff.count_type": {"attr": "count-type"}, "xliff.unit": {"attr": "unit"}}},
    {"match": "trans-unit/count-group/count", "as": "block", "kind": "paragraph", "with": [{"attr": "count-type"}, {"attr": "unit"}], "note": "in the row's other column, where a block's Attrs are not kept"},
    {"match": "header/glossary", "as": "transparent", "mark": {"xliff.field": "glossary"}},
    {"match": "header/reference", "as": "transparent", "mark": {"xliff.field": "reference"}},
    {"match": "header/skl", "as": "transparent", "mark": {"xliff.field": "skl"}},
    {"match": "external-file", "as": "note", "type": "attribute", "value": {"attr": "href"}, "attrs": {"xliff.uid": {"attr": "uid"}, "xliff.crc": {"attr": "crc"}}},
    {"match": "internal-file", "as": "block", "kind": "paragraph", "attrs": {"xliff.form": {"attr": "form"}}},
    {"match": "internal-file[@form='base64']", "as": "document", "encoding": "base64", "media_type": {"attr": "mime-type"}},

    {"match": "/xliff/file/body", "as": "table", "header": ["id", "resname", "restype", "approved", "translate", "source", "target", "notes", "other"], "attrs": {"xliff.original": {"attr": "original", "of": "file"}}},
    {"match": "group", "as": "transparent"},
    {"match": "trans-unit", "as": "row", "anchor": {"attr": "id"}, "cells": [{"attr": "id"}, {"attr": "resname"}, {"attr": "restype"}, {"attr": "approved"}, {"attr": "translate"}], "rest": 9},
    {"match": "trans-unit/source", "as": "cell", "column": 6},
    {"match": "trans-unit/target", "as": "cell", "column": 7},
    {"match": "trans-unit/note", "as": "cell", "column": 8, "with": [{"attr": "from"}]},
    {"match": "trans-unit/seg-source", "as": "block", "kind": "paragraph"},
    {"match": "alt-trans", "as": "transparent"},
    {"match": "alt-trans/source", "as": "block", "kind": "paragraph"},
    {"match": "alt-trans/target", "as": "block", "kind": "paragraph"},
    {"match": "alt-trans/note", "as": "block", "kind": "paragraph"},
    {"match": "context-group", "as": "transparent"},
    {"match": "context", "as": "block", "kind": "paragraph", "attrs": {"xliff.field": "context", "xliff.context_type": {"attr": "context-type"}}},
    {"match": "trans-unit/context-group/context", "as": "block", "kind": "paragraph", "with": [{"attr": "context-type"}], "note": "in the row's other column, where a block's Attrs are not kept"},
    {"match": "trans-unit/count-group", "as": "transparent"},
    {"match": "group/note", "as": "block", "kind": "paragraph"},
    {"match": "bin-unit", "as": "row", "anchor": {"attr": "id"}, "cells": [{"attr": "id"}, {"attr": "resname"}, {"attr": "restype"}, {"attr": "approved"}, {"attr": "translate"}], "rest": 9},
    {"match": "bin-unit/bin-source", "as": "cell", "column": 6},
    {"match": "bin-unit/bin-target", "as": "cell", "column": 7},
    {"match": "bin-unit/note", "as": "cell", "column": 8, "with": [{"attr": "from"}]},
    {"match": "bin-unit/trans-unit", "as": "block", "kind": "paragraph"},
    {"match": "bin-unit/trans-unit/source", "as": "block", "kind": "paragraph"},
    {"match": "bin-unit/trans-unit/target", "as": "block", "kind": "paragraph"},

    {"match": "g", "as": "inline"},
    {"match": "mrk", "as": "inline"},
    {"match": "sub", "as": "inline"},
    {"match": "bpt", "as": "inline", "style": "code"},
    {"match": "ept", "as": "inline", "style": "code"},
    {"match": "ph", "as": "inline", "style": "code"},
    {"match": "it", "as": "inline", "style": "code"},
    {"match": "ut", "as": "inline", "style": "code"},
    {"match": "x", "as": "inline", "value": {"attr": "equiv-text"}},
    {"match": "bx", "as": "inline", "value": {"attr": "equiv-text"}},
    {"match": "ex", "as": "inline", "value": {"attr": "equiv-text"}}
  ]
}
