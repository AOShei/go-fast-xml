{
  "profile": "boamp",
  "title": "BOAMP, French public procurement notices (DILA open data: schema 3.2.5 and the older ANNONCE files)",
  "format": 1,
  "namespaces": {
    "jo": "http://boamp.journal-officiel.gouv.fr/XML/3.2.5",
    "cac": "urn:boamp:names:specification:ubl:schema:xsd:CommonAggregateComponents-2",
    "cbc": "urn:boamp:names:specification:ubl:schema:xsd:CommonBasicComponents-2",
    "ext": "urn:boamp:names:specification:ubl:schema:xsd:CommonExtensionComponents-2",
    "efext": "http://data.europa.eu/p27/eforms-ubl-extensions/1",
    "efac": "http://data.europa.eu/p27/eforms-ubl-extension-aggregate-components/1",
    "efbc": "http://data.europa.eu/p27/eforms-ubl-extension-basic-components/1"
  },
  "match": [
    {
      "root": "ann",
      "namespace": "http://boamp.journal-officiel.gouv.fr/XML/3.2.5"
    },
    {
      "root": "ANNONCE"
    }
  ],
  "heading_base": 2,
  "notes": "See profiles/boamp.md. GESTION and DONNEES are tables of names and values, the name being the file's own element path; an element whose presence is the value (OUVERT, JOUE) is a row with an empty value. The notice's title is the level-1 heading, each lot a section. An eForms notice inside DONNEES/EFORMS is read as the eforms profile reads one. HTML and HTMLSYNTHESE, the notice as a page, are handed to the child extractor.",
  "rules": [
    {"match": "/jo:ann", "as": "transparent"},
    {"match": "/ANNONCE", "as": "transparent"},
    {"match": "/*/GESTION", "as": "transparent"},
    {"match": "/*/GESTION/*", "as": "table", "pairs": "path", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/*/DONNEES", "as": "transparent"},
    {"match": "/*/DONNEES/*", "as": "table", "pairs": "path", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/*/DONNEES/OBJET", "as": "transparent"},
    {"match": "/*/DONNEES/OBJET/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/*/DONNEES/OBJET/TITRE_MARCHE", "as": "metadata", "field": "title", "also_heading": 1},
    {"match": "/*/DONNEES/OBJET/OBJET_COMPLET", "as": "block", "kind": "paragraph", "attrs": {"boamp.field": "OBJET_COMPLET"}},
    {"match": "/*/DONNEES/OBJET/LOTS", "as": "transparent"},
    {"match": "/*/DONNEES/OBJET/LOTS/LOT", "as": "section"},
    {"match": "/*/DONNEES/OBJET/LOTS/LOT/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/*/DONNEES/OBJET/LOTS/LOT/INTITULE", "as": "heading", "level": 2},
    {"match": "/*/DONNEES/OBJET/LOTS/LOT/DESCRIPTION", "as": "block", "kind": "paragraph", "attrs": {"boamp.field": "DESCRIPTION"}},
    {"match": "/*/DONNEES/OBJET/LOTS/LOT/INFO_COMPL", "as": "block", "kind": "paragraph", "attrs": {"boamp.field": "INFO_COMPL"}},
    {"match": "/*/DONNEES/RENSEIGNEMENTS_COMPLEMENTAIRES", "as": "transparent"},
    {"match": "/*/DONNEES/RENSEIGNEMENTS_COMPLEMENTAIRES/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/*/DONNEES/RENSEIGNEMENTS_COMPLEMENTAIRES/RENS_COMPLEMENT", "as": "block", "kind": "paragraph", "attrs": {"boamp.field": "RENS_COMPLEMENT"}},
    {"match": "/*/DONNEES/FNSimple", "as": "transparent"},
    {"match": "/*/DONNEES/FNSimple/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/*/DONNEES/MAPA", "as": "transparent"},
    {"match": "/*/DONNEES/MAPA/*", "as": "table", "pairs": "parent", "pairs_empty": true, "header": ["name", "value"]},
    {"match": "/jo:ann/DONNEES/EFORMS", "as": "transparent", "note": "an eForms notice, in BOAMP's own namespaces for the UBL components: read as the eforms profile reads one"},
    {"match": "/jo:ann/DONNEES/EFORMS/*", "as": "transparent"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/*", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions", "as": "transparent"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions/ext:UBLExtension", "as": "transparent"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent", "as": "transparent"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension", "as": "transparent"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/*", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:Organizations", "as": "transparent"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:Organizations/*", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeResult", "as": "transparent"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeResult/*", "as": "table", "pairs": "parent", "header": ["name", "value"]},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProject", "as": "transparent"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProject/*", "as": "table", "pairs": "parent", "header": ["name", "value"]},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProject/cbc:Name", "as": "metadata", "field": "title", "also_heading": 1, "extra": {"boamp.title_language": {"attr": "languageID"}}},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProject/cbc:Description", "as": "block", "kind": "paragraph", "attrs": {"boamp.field": "Description", "boamp.languageID": {"attr": "languageID"}}},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProject/cbc:Note", "as": "block", "kind": "paragraph", "attrs": {"boamp.field": "Note", "boamp.languageID": {"attr": "languageID"}}},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProjectLot", "as": "section", "anchor": {"child": "cbc:ID"}, "heading": "anchor", "attrs": {"boamp.scheme": {"attr": "schemeName", "child": "cbc:ID"}}},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProjectLot/*", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProjectLot/cac:ProcurementProject", "as": "section"},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProjectLot/cac:ProcurementProject/*", "as": "table", "pairs": "parent", "header": ["name", "value"]},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProjectLot/cac:ProcurementProject/cbc:Name", "as": "heading", "level": "nesting", "attrs": {"boamp.languageID": {"attr": "languageID"}}},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProjectLot/cac:ProcurementProject/cbc:Description", "as": "block", "kind": "paragraph", "attrs": {"boamp.field": "Description", "boamp.languageID": {"attr": "languageID"}}},
    {"match": "/jo:ann/DONNEES/EFORMS/*/cac:ProcurementProjectLot/cac:ProcurementProject/cbc:Note", "as": "block", "kind": "paragraph", "attrs": {"boamp.field": "Note", "boamp.languageID": {"attr": "languageID"}}},
    {"match": "/jo:ann/HTML", "as": "document", "media_type": "text/html", "attrs": {"boamp.field": "HTML"}},
    {"match": "/jo:ann/HTMLSYNTHESE", "as": "document", "media_type": "text/html", "attrs": {"boamp.field": "HTMLSYNTHESE"}}
  ]
}
