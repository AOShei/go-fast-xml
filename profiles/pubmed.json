{
  "profile": "pubmed",
  "title": "PubMed / MEDLINE citations (NLM PubMedArticle DTD): E-utilities efetch results and baseline files",
  "format": 1,
  "namespaces": {
    "mml": "http://www.w3.org/1998/Math/MathML"
  },
  "match": [
    {"root": "PubmedArticleSet"}
  ],
  "heading_base": 1,
  "notes": "See profiles/pubmed.md. One section per record, its anchor the PMID as written; identifiers, dates and codes are name and value tables with the file's names.",
  "rules": [
    {"match": "/PubmedArticleSet", "as": "transparent"},

    {"match": "/PubmedArticleSet/PubmedArticle", "as": "section", "anchor": {"child": "MedlineCitation/PMID"}, "heading": "anchor", "attrs": {"pubmed.pmid_version": {"attr": "Version", "child": "MedlineCitation/PMID"}}},
    {"match": "PubmedArticle/MedlineCitation", "as": "transparent", "attrs": {"pubmed.status": {"attr": "Status"}, "pubmed.owner": {"attr": "Owner"}, "pubmed.indexing_method": {"attr": "IndexingMethod"}, "pubmed.version_id": {"attr": "VersionID"}, "pubmed.version_date": {"attr": "VersionDate"}}},
    {"match": "MedlineCitation/Article", "as": "transparent", "attrs": {"pubmed.pub_model": {"attr": "PubModel"}}},
    {"match": "MedlineCitation/Article/ArticleTitle", "as": "heading", "level": 2},
    {"match": "MedlineCitation/Article/VernacularTitle", "as": "block", "kind": "paragraph", "attrs": {"pubmed.field": "VernacularTitle"}},
    {"match": "PubmedArticle/PubmedData", "as": "transparent"},

    {"match": "/PubmedArticleSet/PubmedBookArticle", "as": "section", "anchor": {"child": "BookDocument/PMID"}, "heading": "anchor", "attrs": {"pubmed.pmid_version": {"attr": "Version", "child": "BookDocument/PMID"}}},
    {"match": "PubmedBookArticle/BookDocument", "as": "transparent"},
    {"match": "BookDocument/Book", "as": "transparent"},
    {"match": "BookDocument/Book/BookTitle", "as": "heading", "level": 2, "attrs": {"pubmed.book": {"attr": "book"}, "pubmed.part": {"attr": "part"}, "pubmed.sec": {"attr": "sec"}}},
    {"match": "BookDocument/ArticleTitle", "as": "heading", "level": 3, "attrs": {"pubmed.book": {"attr": "book"}, "pubmed.part": {"attr": "part"}, "pubmed.sec": {"attr": "sec"}}},
    {"match": "BookDocument/VernacularTitle", "as": "block", "kind": "paragraph", "attrs": {"pubmed.field": "VernacularTitle"}},
    {"match": "Book/VolumeTitle", "as": "block", "kind": "paragraph", "attrs": {"pubmed.field": "VolumeTitle", "pubmed.book": {"attr": "book"}, "pubmed.part": {"attr": "part"}, "pubmed.sec": {"attr": "sec"}}},
    {"match": "Book/CollectionTitle", "as": "block", "kind": "paragraph", "attrs": {"pubmed.field": "CollectionTitle", "pubmed.book": {"attr": "book"}, "pubmed.part": {"attr": "part"}, "pubmed.sec": {"attr": "sec"}}},
    {"match": "BookDocument/Sections", "as": "list"},
    {"match": "Section", "as": "item", "attrs": {"pubmed.book": {"attr": "book", "child": "SectionTitle"}, "pubmed.part": {"attr": "part", "child": "SectionTitle"}, "pubmed.sec": {"attr": "sec", "child": "SectionTitle"}, "pubmed.location_label_type": {"attr": "Type", "child": "LocationLabel"}}},
    {"match": "Section/SectionTitle", "as": "inline", "space": true},
    {"match": "Section/LocationLabel", "as": "inline", "space": true},
    {"match": "BookDocument/LocationLabel", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "BookDocument/ItemList", "as": "list", "attrs": {"pubmed.list_type": {"attr": "ListType"}}},
    {"match": "ItemList/Item", "as": "item"},
    {"match": "PubmedBookArticle/PubmedBookData", "as": "transparent"},

    {"match": "/PubmedArticleSet/DeleteCitation", "as": "table", "pairs": "local", "header": ["name", "value"], "attrs": {"pubmed.field": "DeleteCitation"}},

    {"match": "Abstract", "as": "transparent", "mark": {"pubmed.in": "Abstract"}},
    {"match": "OtherAbstract", "as": "transparent", "mark": {"pubmed.in": "OtherAbstract", "pubmed.language": {"attr": "Language"}, "pubmed.abstract_type": {"attr": "Type"}}},
    {"match": "AbstractText", "as": "block", "kind": "paragraph", "marker": {"attr": "Label"}, "attrs": {"pubmed.nlm_category": {"attr": "NlmCategory"}}},
    {"match": "CopyrightInformation", "as": "block", "kind": "paragraph", "attrs": {"pubmed.field": "CopyrightInformation"}},
    {"match": "CoiStatement", "as": "block", "kind": "paragraph", "attrs": {"pubmed.field": "CoiStatement"}},
    {"match": "GeneralNote", "as": "block", "kind": "paragraph", "attrs": {"pubmed.field": "GeneralNote", "pubmed.owner": {"attr": "Owner"}}},

    {"match": "AuthorList", "as": "table", "attrs": {"pubmed.complete": {"attr": "CompleteYN"}, "pubmed.list_type": {"attr": "Type"}},
      "header": ["last name", "fore name", "initials", "suffix", "collective name", "identifier", "affiliation"]},
    {"match": "InvestigatorList", "as": "table",
      "header": ["last name", "fore name", "initials", "suffix", "collective name", "identifier", "affiliation"]},
    {"match": "AuthorList/Author", "as": "row", "rest_table": {"names": "path", "id": 1, "header": ["last name", "name", "value"]}},
    {"match": "InvestigatorList/Investigator", "as": "row", "rest_table": {"names": "path", "id": 1, "header": ["last name", "name", "value"]}},
    {"match": "Author/LastName", "as": "cell", "column": 1},
    {"match": "Author/ForeName", "as": "cell", "column": 2},
    {"match": "Author/Initials", "as": "cell", "column": 3},
    {"match": "Author/Suffix", "as": "cell", "column": 4},
    {"match": "Author/CollectiveName", "as": "cell", "column": 5},
    {"match": "Author/Identifier", "as": "cell", "column": 6, "with": [{"attr": "Source"}]},
    {"match": "Author/AffiliationInfo", "as": "cell", "column": 7},
    {"match": "Investigator/LastName", "as": "cell", "column": 1},
    {"match": "Investigator/ForeName", "as": "cell", "column": 2},
    {"match": "Investigator/Initials", "as": "cell", "column": 3},
    {"match": "Investigator/Suffix", "as": "cell", "column": 4},
    {"match": "Investigator/CollectiveName", "as": "cell", "column": 5},
    {"match": "Investigator/Identifier", "as": "cell", "column": 6, "with": [{"attr": "Source"}]},
    {"match": "Investigator/AffiliationInfo", "as": "cell", "column": 7},
    {"match": "AffiliationInfo/Affiliation", "as": "inline", "space": true},
    {"match": "AffiliationInfo/Identifier", "as": "inline", "space": true, "with": [{"attr": "Source"}]},

    {"match": "DateCompleted", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "DateRevised", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "ArticleDate", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "ContributionDate", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "Journal", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "Pagination", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "ELocationID", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "Language", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "DataBankList", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "GrantList", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "PublicationTypeList", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "BookDocument/PublicationType", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "MedlineJournalInfo", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "ChemicalList", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "SupplMeshList", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "CitationSubset", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "CommentsCorrectionsList", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "GeneSymbolList", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "MeshHeadingList", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "NumberOfReferences", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "PersonalNameSubjectList", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "OtherID", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "KeywordList", "as": "list", "mark": {"pubmed.in": "KeywordList", "pubmed.owner": {"attr": "Owner"}}},
    {"match": "KeywordList/Keyword", "as": "item", "attrs": {"pubmed.major_topic": {"attr": "MajorTopicYN"}}},
    {"match": "SpaceFlightMission", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "History", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "PublicationStatus", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "ArticleIdList", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "ObjectList", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "Book/Publisher", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "Book/PubDate", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "Book/BeginningDate", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "Book/EndingDate", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "Book/Volume", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "Book/Edition", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "Book/Medium", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "Book/ReportNumber", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "Book/Isbn", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "Book/ELocationID", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "BookDocument/ArticleIdList", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "BookDocument/Language", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "BookDocument/DateRevised", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "BookDocument/GrantList", "as": "table", "pairs": "path", "header": ["name", "value"]},

    {"match": "ReferenceList", "as": "list", "mark": {"pubmed.in": "ReferenceList"}},
    {"match": "ReferenceList/Title", "as": "heading", "level": 3},
    {"match": "ReferenceList/Reference", "as": "item"},
    {"match": "Reference/Citation", "as": "inline", "space": true},
    {"match": "Reference/ArticleIdList", "as": "table", "pairs": "local", "header": ["name", "value"]},

    {"match": "i", "as": "inline", "style": "italic"},
    {"match": "b", "as": "inline", "style": "bold"},
    {"match": "sup", "as": "inline", "style": "superscript"},
    {"match": "sub", "as": "inline", "style": "subscript"},
    {"match": "u", "as": "inline"},
    {"match": "DispFormula", "as": "block", "kind": "formula", "notation": "plain", "attrs": {"pubmed.math": "mathml"}},
    {"match": "mml:math", "as": "inline"},
    {"match": "mml:mrow", "as": "inline"}, {"match": "mml:mi", "as": "inline"}, {"match": "mml:mo", "as": "inline"},
    {"match": "mml:mn", "as": "inline"}, {"match": "mml:msub", "as": "inline"}, {"match": "mml:msup", "as": "inline"},
    {"match": "mml:msubsup", "as": "inline"}, {"match": "mml:mfrac", "as": "inline"}, {"match": "mml:mover", "as": "inline"},
    {"match": "mml:munder", "as": "inline"}, {"match": "mml:munderover", "as": "inline"}, {"match": "mml:mspace", "as": "inline"},
    {"match": "mml:mtext", "as": "inline"}, {"match": "mml:mstyle", "as": "inline"}, {"match": "mml:msqrt", "as": "inline"},
    {"match": "mml:mroot", "as": "inline"}, {"match": "mml:mfenced", "as": "inline"}, {"match": "mml:mpadded", "as": "inline"},
    {"match": "mml:mphantom", "as": "inline"}, {"match": "mml:menclose", "as": "inline"}, {"match": "mml:mmultiscripts", "as": "inline"},
    {"match": "mml:mprescripts", "as": "inline"}, {"match": "mml:none", "as": "inline"}, {"match": "mml:semantics", "as": "inline"},
    {"match": "mml:annotation", "as": "inline", "space": true}, {"match": "mml:annotation-xml", "as": "inline", "space": true}, {"match": "mml:ms", "as": "inline"},
    {"match": "mml:merror", "as": "inline"}, {"match": "mml:maction", "as": "inline"}, {"match": "mml:mglyph", "as": "inline"},
    {"match": "mml:mtable", "as": "inline", "space": true}, {"match": "mml:mtr", "as": "inline", "space": true}, {"match": "mml:mlabeledtr", "as": "inline", "space": true},
    {"match": "mml:mtd", "as": "inline", "space": true}, {"match": "mml:maligngroup", "as": "inline"}, {"match": "mml:malignmark", "as": "inline"}
  ]
}
