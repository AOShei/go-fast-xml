{
  "profile": "jats",
  "title": "JATS 1.x and NLM 3.0 journal articles (NISO Z39.96), and PMC article sets",
  "format": 1,
  "namespaces": {
    "xlink": "http://www.w3.org/1999/xlink",
    "mml": "http://www.w3.org/1998/Math/MathML",
    "ali": "http://www.niso.org/schemas/ali/1.0/",
    "oasis": "http://www.niso.org/standards/z39-96/ns/oasis-exchange/table"
  },
  "match": [
    {"root": "article", "doctype_public": "-//NLM//DTD"},
    {"root": "article", "doctype_public": "-//NISO//DTD"},
    {"root": "article", "attr": "[@dtd-version]"},
    {"root": "article", "attr": "[@article-type]"},
    {"root": "pmc-articleset"}
  ],
  "heading_base": 2,
  "rules": [
    {"match": "/pmc-articleset", "as": "transparent"},
    {"match": "article", "as": "transparent", "extra": {"jats.article_type": {"attr": "article-type"}, "jats.dtd_version": {"attr": "dtd-version"}, "jats.lang": {"attr": "xml:lang"}, "jats.specific_use": {"attr": "specific-use"}}},
    {"match": "article/front", "as": "part", "kind": "body", "name": "front"},
    {"match": "article/body", "as": "part", "kind": "body", "name": "body"},
    {"match": "article/back", "as": "part", "kind": "body", "name": "back"},
    {"match": "article/floats-group", "as": "part", "kind": "body", "name": "floats-group"},
    {"match": "sub-article", "as": "part", "kind": "chapter", "name": {"attr": "article-type"}, "anchor": {"attr": "id"}, "mark": {"jats.sub_article": {"attr": "id"}}, "attrs": {"jats.lang": {"attr": "xml:lang"}}},
    {"match": "sub-article/front-stub", "as": "transparent"},
    {"match": "sub-article/front", "as": "transparent"},
    {"match": "sub-article/body", "as": "transparent"},
    {"match": "sub-article/back", "as": "transparent"},
    {"match": "sub-article/floats-group", "as": "transparent"},
    {"match": "response", "as": "part", "kind": "chapter", "name": {"attr": "response-type"}, "anchor": {"attr": "id"}},
    {"match": "response/front-stub", "as": "transparent"},
    {"match": "response/body", "as": "transparent"},
    {"match": "response/back", "as": "transparent"},

    {"match": "processing-meta", "as": "transparent", "extra": {"jats.tagset_family": {"attr": "tagset-family"}, "jats.base_tagset": {"attr": "base-tagset"}, "jats.table_model": {"attr": "table-model"}, "jats.mathml_version": {"attr": "mathml-version"}}},
    {"match": "processing-meta/restricted-by", "as": "metadata", "field": "extra", "key": "jats.restricted_by", "join": "; "},
    {"match": "processing-meta/extended-by", "as": "metadata", "field": "extra", "key": "jats.extended_by", "join": "; "},

    {"match": "journal-meta", "as": "transparent"},
    {"match": "journal-meta/journal-id", "as": "metadata", "field": "extra", "key": "jats.journal_id", "join": "; ", "extra": {"jats.journal_id_type": {"attr": "journal-id-type"}}},
    {"match": "journal-title-group", "as": "transparent"},
    {"match": "journal-title-group/journal-title", "as": "metadata", "field": "extra", "key": "jats.journal", "join": "; "},
    {"match": "journal-title-group/journal-subtitle", "as": "metadata", "field": "extra", "key": "jats.journal_subtitle", "join": "; "},
    {"match": "journal-title-group/abbrev-journal-title", "as": "metadata", "field": "extra", "key": "jats.journal_abbrev", "join": "; ", "extra": {"jats.journal_abbrev_type": {"attr": "abbrev-type"}}},
    {"match": "journal-meta/journal-title", "as": "metadata", "field": "extra", "key": "jats.journal", "join": "; "},
    {"match": "journal-meta/abbrev-journal-title", "as": "metadata", "field": "extra", "key": "jats.journal_abbrev", "join": "; "},
    {"match": "journal-meta/issn", "as": "metadata", "field": "extra", "key": "jats.issn", "join": "; ", "extra": {"jats.issn_type": {"attr": "pub-type"}, "jats.issn_format": {"attr": "publication-format"}}},
    {"match": "journal-meta/isbn", "as": "metadata", "field": "extra", "key": "jats.isbn", "join": "; "},
    {"match": "journal-meta/issn-l", "as": "metadata", "field": "extra", "key": "jats.issn_l"},
    {"match": "journal-meta/publisher", "as": "transparent"},
    {"match": "publisher/publisher-name", "as": "metadata", "field": "extra", "key": "jats.publisher", "join": "; "},
    {"match": "publisher/publisher-loc", "as": "metadata", "field": "extra", "key": "jats.publisher_loc", "join": "; "},
    {"match": "journal-meta/self-uri", "as": "metadata", "field": "extra", "key": "jats.journal_uri", "extra": {"jats.journal_uri_href": {"attr": "xlink:href"}}},

    {"match": "article-meta", "as": "transparent"},
    {"match": "article-meta/article-id[@pub-id-type='doi']", "as": "metadata", "field": "extra", "key": "jats.doi"},
    {"match": "article-meta/article-id[@pub-id-type='pmid']", "as": "metadata", "field": "extra", "key": "jats.pmid"},
    {"match": "article-meta/article-id[@pub-id-type='pmcid']", "as": "metadata", "field": "extra", "key": "jats.pmcid"},
    {"match": "article-meta/article-id[@pub-id-type='pmc']", "as": "metadata", "field": "extra", "key": "jats.pmc"},
    {"match": "article-meta/article-id[@pub-id-type='publisher-id']", "as": "metadata", "field": "extra", "key": "jats.publisher_id"},
    {"match": "article-meta/article-id", "as": "metadata", "field": "extra", "key": "jats.article_id", "join": "; ", "extra": {"jats.article_id_type": {"attr": "pub-id-type"}}},
    {"match": "article-meta/article-version", "as": "metadata", "field": "extra", "key": "jats.article_version", "extra": {"jats.article_version_type": {"attr": "article-version-type"}}},
    {"match": "article-meta/article-categories", "as": "transparent"},
    {"match": "subj-group", "as": "transparent"},
    {"match": "subj-group/subject", "as": "metadata", "field": "extra", "key": "jats.subject", "join": "; ", "extra": {"jats.subject_group_type": {"attr": "subj-group-type", "of": "subj-group"}}},
    {"match": "subj-group/compound-subject", "as": "metadata", "field": "extra", "key": "jats.subject", "join": "; "},
    {"match": "compound-subject-part", "as": "inline", "space": true},
    {"match": "article-categories/series-title", "as": "metadata", "field": "extra", "key": "jats.series_title", "join": "; "},
    {"match": "article-meta/title-group", "as": "transparent"},
    {"match": "article-meta/title-group/article-title", "as": "metadata", "field": "title", "also_heading": 1},
    {"match": "title-group/subtitle", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "subtitle"}},
    {"match": "title-group/alt-title", "as": "metadata", "field": "extra", "key": "jats.alt_title", "join": "; ", "extra": {"jats.alt_title_type": {"attr": "alt-title-type"}}},
    {"match": "title-group/trans-title-group", "as": "transparent", "extra": {"jats.trans_title_lang": {"attr": "xml:lang"}}},
    {"match": "trans-title-group/trans-title", "as": "metadata", "field": "extra", "key": "jats.trans_title", "join": "; "},
    {"match": "trans-title-group/trans-subtitle", "as": "metadata", "field": "extra", "key": "jats.trans_subtitle", "join": "; "},
    {"match": "title-group/fn-group", "as": "transparent"},

    {"match": "contrib-group", "as": "transparent"},
    {"match": "contrib", "as": "block", "kind": "paragraph", "anchor": {"attr": "id"}, "attrs": {"jats.field": "contrib", "jats.contrib_type": {"attr": "contrib-type"}, "jats.corresp": {"attr": "corresp"}, "jats.equal_contrib": {"attr": "equal-contrib"}, "jats.deceased": {"attr": "deceased"}}},
    {"match": "article-meta/contrib-group/contrib/name", "as": "metadata", "field": "author"},
    {"match": "article-meta/contrib-group/contrib/string-name", "as": "metadata", "field": "author"},
    {"match": "article-meta/contrib-group/contrib/collab", "as": "metadata", "field": "author"},
    {"match": "article-meta/contrib-group/contrib/name-alternatives", "as": "metadata", "field": "author"},
    {"match": "contrib-id", "as": "inline", "space": true},
    {"match": "role", "as": "inline", "space": true},
    {"match": "degrees", "as": "inline", "space": true},
    {"match": "on-behalf-of", "as": "inline", "space": true},
    {"match": "author-comment", "as": "inline", "space": true},
    {"match": "bio", "as": "block", "kind": "paragraph", "anchor": {"attr": "id"}, "attrs": {"jats.field": "bio"}},
    {"match": "address", "as": "inline", "space": true},
    {"match": "phone", "as": "inline", "space": true},
    {"match": "fax", "as": "inline", "space": true},
    {"match": "email", "as": "inline", "space": true},
    {"match": "aff", "as": "block", "kind": "paragraph", "anchor": {"attr": "id"}, "attrs": {"jats.field": "aff"}},
    {"match": "aff-alternatives", "as": "transparent", "anchor": {"attr": "id"}},
    {"match": "aff/label", "as": "label"},
    {"match": "institution-wrap", "as": "inline", "space": true},
    {"match": "institution", "as": "inline", "space": true},
    {"match": "institution-id", "as": "inline", "space": true},
    {"match": "addr-line", "as": "inline", "space": true},
    {"match": "country", "as": "inline", "space": true},
    {"match": "city", "as": "inline", "space": true},
    {"match": "state", "as": "inline", "space": true},
    {"match": "postal-code", "as": "inline", "space": true},
    {"match": "author-notes", "as": "transparent", "mark": {"jats.in": "author-notes"}},
    {"match": "author-notes/title", "as": "heading", "level": "nesting"},
    {"match": "corresp", "as": "block", "kind": "paragraph", "anchor": {"attr": "id"}, "attrs": {"jats.field": "corresp"}},
    {"match": "corresp/label", "as": "label"},

    {"match": "article-meta/pub-date", "as": "metadata", "field": "extra", "key": "jats.pub_date", "join": "; ", "extra": {"jats.pub_date_type": {"attr": "pub-type"}, "jats.pub_date_date_type": {"attr": "date-type"}, "jats.pub_date_format": {"attr": "publication-format"}, "jats.pub_date_iso": {"attr": "iso-8601-date"}}},
    {"match": "article-meta/pub-date-not-available", "as": "metadata", "field": "extra", "key": "jats.pub_date"},
    {"match": "day", "as": "inline", "space": true},
    {"match": "month", "as": "inline", "space": true},
    {"match": "year", "as": "inline", "space": true},
    {"match": "season", "as": "inline", "space": true},
    {"match": "era", "as": "inline", "space": true},
    {"match": "string-date", "as": "inline", "space": true},
    {"match": "article-meta/volume", "as": "metadata", "field": "extra", "key": "jats.volume", "join": "; "},
    {"match": "article-meta/volume-id", "as": "metadata", "field": "extra", "key": "jats.volume_id", "join": "; "},
    {"match": "article-meta/issue", "as": "metadata", "field": "extra", "key": "jats.issue", "join": "; "},
    {"match": "article-meta/issue-id", "as": "metadata", "field": "extra", "key": "jats.issue_id", "join": "; ", "extra": {"jats.issue_id_type": {"attr": "pub-id-type"}}},
    {"match": "article-meta/issue-title", "as": "metadata", "field": "extra", "key": "jats.issue_title", "join": "; "},
    {"match": "article-meta/fpage", "as": "metadata", "field": "extra", "key": "jats.fpage"},
    {"match": "article-meta/lpage", "as": "metadata", "field": "extra", "key": "jats.lpage"},
    {"match": "article-meta/page-range", "as": "metadata", "field": "extra", "key": "jats.page_range"},
    {"match": "article-meta/elocation-id", "as": "metadata", "field": "extra", "key": "jats.elocation_id"},
    {"match": "article-meta/history", "as": "transparent"},
    {"match": "history/date", "as": "metadata", "field": "extra", "key": "jats.history", "join": "; ", "extra": {"jats.history_type": {"attr": "date-type"}, "jats.history_iso": {"attr": "iso-8601-date"}}},
    {"match": "article-meta/pub-history", "as": "transparent"},
    {"match": "pub-history/event", "as": "metadata", "field": "extra", "key": "jats.pub_history", "join": "; ", "extra": {"jats.pub_history_type": {"attr": "event-type"}}},
    {"match": "event-desc", "as": "inline", "space": true},
    {"match": "event/date", "as": "inline", "space": true},
    {"match": "event/pub-date", "as": "inline", "space": true},
    {"match": "event/article-id", "as": "inline", "space": true},
    {"match": "event/article-version", "as": "inline", "space": true},
    {"match": "event/self-uri", "as": "inline", "space": true, "link": {"attr": "xlink:href"}},
    {"match": "article-meta/permissions", "as": "transparent"},
    {"match": "article-meta/permissions/copyright-statement", "as": "metadata", "field": "extra", "key": "jats.copyright", "join": "; "},
    {"match": "article-meta/permissions/copyright-year", "as": "metadata", "field": "extra", "key": "jats.copyright_year", "join": "; "},
    {"match": "article-meta/permissions/copyright-holder", "as": "metadata", "field": "extra", "key": "jats.copyright_holder", "join": "; "},
    {"match": "article-meta/permissions/license", "as": "metadata", "field": "extra", "key": "jats.license", "join": "\n", "extra": {"jats.license_href": {"attr": "xlink:href"}, "jats.license_type": {"attr": "license-type"}}},
    {"match": "license-p", "as": "inline", "space": true},
    {"match": "ali:license_ref", "as": "inline", "space": true},
    {"match": "article-meta/permissions/ali:license_ref", "as": "metadata", "field": "extra", "key": "jats.license_ref", "join": "; "},
    {"match": "article-meta/permissions/ali:free_to_read", "as": "metadata", "field": "extra", "key": "jats.free_to_read", "value": "yes"},
    {"match": "permissions", "as": "transparent", "mark": {"jats.in": "permissions"}},
    {"match": "permissions/copyright-statement", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "copyright-statement"}},
    {"match": "permissions/copyright-year", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "copyright-year"}},
    {"match": "permissions/copyright-holder", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "copyright-holder"}},
    {"match": "permissions/license", "as": "transparent", "attrs": {"jats.license_href": {"attr": "xlink:href"}, "jats.license_type": {"attr": "license-type"}}},
    {"match": "permissions/license/license-p", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "license"}},
    {"match": "permissions/license/ali:license_ref", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "license_ref"}},
    {"match": "permissions/ali:license_ref", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "license_ref"}},
    {"match": "permissions/ali:free_to_read", "as": "transparent", "attrs": {"jats.free_to_read": "yes"}},
    {"match": "article-meta/self-uri", "as": "metadata", "field": "extra", "key": "jats.self_uri", "join": "; ", "extra": {"jats.self_uri_href": {"attr": "xlink:href"}, "jats.self_uri_type": {"attr": "content-type"}}},
    {"match": "article-meta/related-article", "as": "block", "kind": "paragraph", "value": {"attr": "xlink:href"}, "anchor": {"attr": "id"}, "attrs": {"jats.field": "related-article", "jats.related_type": {"attr": "related-article-type"}}},
    {"match": "article-meta/kwd-group", "as": "transparent", "extra": {"jats.kwd_group_type": {"attr": "kwd-group-type"}}},
    {"match": "kwd-group/kwd", "as": "metadata", "field": "keyword"},
    {"match": "kwd-group/compound-kwd", "as": "metadata", "field": "keyword"},
    {"match": "compound-kwd-part", "as": "inline", "space": true},
    {"match": "kwd-group/title", "as": "metadata", "field": "extra", "key": "jats.kwd_group_title", "join": "; "},
    {"match": "kwd-group/label", "as": "metadata", "field": "extra", "key": "jats.kwd_group_label", "join": "; "},
    {"match": "article-meta/funding-group", "as": "transparent"},
    {"match": "funding-group/award-group", "as": "metadata", "field": "extra", "key": "jats.funding", "join": "; ", "extra": {"jats.funding_id": {"attr": "id"}}},
    {"match": "funding-source", "as": "inline", "space": true},
    {"match": "award-id", "as": "inline", "space": true},
    {"match": "principal-award-recipient", "as": "inline", "space": true},
    {"match": "principal-investigator", "as": "inline", "space": true},
    {"match": "funding-group/funding-statement", "as": "metadata", "field": "extra", "key": "jats.funding_statement", "join": "; "},
    {"match": "custom-meta-group", "as": "transparent"},
    {"match": "custom-meta-group/custom-meta", "as": "metadata", "field": "extra", "key": "jats.custom_meta", "join": "; "},
    {"match": "meta-name", "as": "inline", "space": true},
    {"match": "meta-value", "as": "inline", "space": true},
    {"match": "article-meta/counts", "as": "transparent"},
    {"match": "counts/page-count", "as": "metadata", "field": "extra", "key": "jats.page_count", "value": {"attr": "count"}},
    {"match": "counts/fig-count", "as": "metadata", "field": "extra", "key": "jats.fig_count", "value": {"attr": "count"}},
    {"match": "counts/table-count", "as": "metadata", "field": "extra", "key": "jats.table_count", "value": {"attr": "count"}},
    {"match": "counts/equation-count", "as": "metadata", "field": "extra", "key": "jats.equation_count", "value": {"attr": "count"}},
    {"match": "counts/ref-count", "as": "metadata", "field": "extra", "key": "jats.ref_count", "value": {"attr": "count"}},
    {"match": "counts/word-count", "as": "metadata", "field": "extra", "key": "jats.word_count", "value": {"attr": "count"}},
    {"match": "front-stub/title-group", "as": "transparent"},
    {"match": "front-stub/title-group/article-title", "as": "heading", "level": 1},
    {"match": "front-stub/article-id", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "article-id", "jats.pub_id_type": {"attr": "pub-id-type"}}},
    {"match": "front-stub/related-article", "as": "block", "kind": "paragraph", "anchor": {"attr": "id"}, "attrs": {"jats.field": "related-article", "jats.related_type": {"attr": "related-article-type"}, "jats.href": {"attr": "xlink:href"}}},
    {"match": "front-stub/pub-date", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "pub-date", "jats.pub_date_type": {"attr": "pub-type"}, "jats.pub_date_iso": {"attr": "iso-8601-date"}}},
    {"match": "front-stub/self-uri", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "self-uri", "jats.href": {"attr": "xlink:href"}}},
    {"match": "front-stub/kwd-group", "as": "transparent"},
    {"match": "front-stub/custom-meta-group/custom-meta", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "custom-meta"}},

    {"match": "abstract", "as": "section", "anchor": {"attr": "id"}, "mark": {"jats.in": "abstract"}, "attrs": {"jats.abstract_type": {"attr": "abstract-type"}, "jats.lang": {"attr": "xml:lang"}}},
    {"match": "trans-abstract", "as": "section", "anchor": {"attr": "id"}, "mark": {"jats.in": "trans-abstract"}, "attrs": {"jats.abstract_type": {"attr": "abstract-type"}, "jats.lang": {"attr": "xml:lang"}}},
    {"match": "abstract/object-id", "as": "block", "kind": "paragraph", "attrs": {"jats.field": "object-id", "jats.pub_id_type": {"attr": "pub-id-type"}}},
    {"match": "abstract/label", "as": "label"},

    {"match": "sec", "as": "section", "anchor": {"attr": "id"}, "attrs": {"jats.sec_type": {"attr": "sec-type"}, "jats.disp_level": {"attr": "disp-level"}, "jats.lang": {"attr": "xml:lang"}, "jats.specific_use": {"attr": "specific-use"}}},
    {"match": "sec/label", "as": "label"},
    {"match": "sec/sec-meta", "as": "transparent"},
    {"match": "sec-meta/kwd-group", "as": "transparent"},
    {"match": "title", "as": "heading", "level": "nesting"},
    {"match": "sec/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "sec"}},
    {"match": "abstract/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "abstract"}},
    {"match": "trans-abstract/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "trans-abstract"}},
    {"match": "ack/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "ack"}},
    {"match": "app/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "app"}},
    {"match": "app-group/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "app-group"}},
    {"match": "ref-list/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "ref-list"}},
    {"match": "fn-group/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "fn-group"}},
    {"match": "notes/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "notes"}},
    {"match": "glossary/title", "as": "heading", "level": "nesting", "anchor": {"attr": "id", "of": "glossary"}},
    {"match": "ack", "as": "section", "anchor": {"attr": "id"}, "mark": {"jats.in": "ack"}},
    {"match": "app-group", "as": "section", "anchor": {"attr": "id"}},
    {"match": "app", "as": "section", "anchor": {"attr": "id"}, "mark": {"jats.in": "app"}},
    {"match": "app/label", "as": "label"},
    {"match": "notes", "as": "section", "anchor": {"attr": "id"}, "attrs": {"jats.notes_type": {"attr": "notes-type"}}},
    {"match": "notes/label", "as": "label"},
    {"match": "glossary", "as": "section", "anchor": {"attr": "id"}, "attrs": {"jats.glossary_type": {"attr": "content-type"}}},
    {"match": "glossary/label", "as": "label"},
    {"match": "bio/title", "as": "heading", "level": "nesting"},

    {"match": "p", "as": "block", "kind": "paragraph", "anchor": {"attr": "id"}, "attrs": {"jats.content_type": {"attr": "content-type"}, "jats.specific_use": {"attr": "specific-use"}}},
    {"match": "disp-quote", "as": "block", "kind": "quote", "anchor": {"attr": "id"}, "attrs": {"jats.content_type": {"attr": "content-type"}}},
    {"match": "attrib", "as": "inline", "space": true},
    {"match": "speech", "as": "block", "kind": "paragraph", "anchor": {"attr": "id"}},
    {"match": "speaker", "as": "inline", "style": "bold"},
    {"match": "verse-group", "as": "block", "kind": "quote", "anchor": {"attr": "id"}, "attrs": {"jats.field": "verse-group"}},
    {"match": "verse-line", "as": "block", "kind": "paragraph"},
