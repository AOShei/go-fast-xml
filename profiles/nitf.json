{
  "profile": "nitf",
  "title": "News Industry Text Format (IPTC NITF 3.x), in no namespace or in http://iptc.org/std/NITF/2006-10-18/",
  "format": 1,
  "namespace_aliases": {"http://iptc.org/std/NITF/2006-10-18/": ""},
  "match": [
    {"root": "nitf"},
    {"root": "nitf", "namespace": "http://iptc.org/std/NITF/2006-10-18/"}
  ],
  "heading_base": 1,
  "notes": "See profiles/nitf.md. The head is a name and value table with the file's names; the headline is the title; body.head fields are paragraphs marked nitf.field.",
  "rules": [
    {"match": "/nitf", "as": "transparent", "anchor": {"attr": "id-string", "child": "head/docdata/doc-id"},
      "attrs": {"nitf.version": {"attr": "version"}, "nitf.change_date": {"attr": "change.date"}, "nitf.change_time": {"attr": "change.time"}, "nitf.baselang": {"attr": "baselang"}, "nitf.uno": {"attr": "uno"}, "nitf.class": {"attr": "class"}}},

    {"match": "nitf/head", "as": "table", "pairs": "path", "header": ["name", "value"]},

    {"match": "nitf/body", "as": "transparent"},
    {"match": "body/body.head", "as": "transparent"},
    {"match": "body/body.content", "as": "transparent"},
    {"match": "body/body.end", "as": "transparent"},
    {"match": "body.head/hedline", "as": "transparent"},
    {"match": "hedline/hl1", "as": "metadata", "field": "title", "also_heading": 1},
    {"match": "hedline/hl2", "as": "heading", "level": 2, "anchor": {"attr": "id"}},
    {"match": "hl2", "as": "heading", "level": 2, "anchor": {"attr": "id"}, "attrs": {"nitf.class": {"attr": "class"}}},
    {"match": "body.head/byline", "as": "block", "kind": "paragraph", "attrs": {"nitf.field": "byline"}},
    {"match": "byline/byttl", "as": "inline", "space": true},
    {"match": "body.head/dateline", "as": "block", "kind": "paragraph", "attrs": {"nitf.field": "dateline"}},
    {"match": "story.date", "as": "inline", "attrs": {"norm": {"attr": "norm"}}},
    {"match": "body.head/distributor", "as": "block", "kind": "paragraph", "attrs": {"nitf.field": "distributor"}},
    {"match": "body.head/rights", "as": "block", "kind": "paragraph", "attrs": {"nitf.field": "rights"}},
    {"match": "rights/rights.owner", "as": "inline", "attrs": {"contact": {"attr": "contact"}}},
    {"match": "rights/rights.startdate", "as": "inline", "attrs": {"norm": {"attr": "norm"}}},
    {"match": "rights/rights.enddate", "as": "inline", "attrs": {"norm": {"attr": "norm"}}},
    {"match": "rights/rights.agent", "as": "inline", "attrs": {"contact": {"attr": "contact"}}},
    {"match": "rights/rights.geography", "as": "inline", "attrs": {"location-code": {"attr": "location-code"}, "code-source": {"attr": "code-source"}}},
    {"match": "rights/rights.type", "as": "inline"},
    {"match": "rights/rights.limitations", "as": "inline"},
    {"match": "body.head/series", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "body.head/abstract", "as": "transparent", "mark": {"nitf.field": "abstract"}},
    {"match": "body.head/note", "as": "transparent", "mark": {"nitf.field": "note", "nitf.noteclass": {"attr": "noteclass"}, "nitf.note_type": {"attr": "type"}}},
    {"match": "note/body.content", "as": "transparent"},
    {"match": "body.end/tagline", "as": "block", "kind": "paragraph", "attrs": {"nitf.field": "tagline"}},
    {"match": "body.end/bibliography", "as": "block", "kind": "paragraph", "attrs": {"nitf.field": "bibliography"}},

    {"match": "p", "as": "block", "kind": "paragraph", "anchor": {"attr": "id"}, "attrs": {"nitf.lede": {"attr": "lede"}, "nitf.class": {"attr": "class"}, "nitf.lang": {"attr": "lang"}, "nitf.xml_lang": {"attr": "xml:lang"}, "nitf.summary": {"attr": "summary"}, "nitf.optional_text": {"attr": "optional-text"}, "nitf.quote_source": {"attr": "quote-source"}, "nitf.lead": {"attr": "lead"}}},
    {"match": "block", "as": "transparent", "anchor": {"attr": "id"}, "mark": {"nitf.class": {"attr": "class"}}},
    {"match": "lang", "as": "transparent", "mark": {"nitf.lang": {"attr": "lang"}}},
    {"match": "bq", "as": "block", "kind": "quote", "anchor": {"attr": "id"}, "attrs": {"nitf.nowrap": {"attr": "nowrap"}, "nitf.quote_source": {"attr": "quote-source"}}},
    {"match": "bq/block", "as": "transparent"},
    {"match": "credit", "as": "block", "kind": "paragraph", "attrs": {"nitf.field": "credit"}},
    {"match": "pre", "as": "block", "kind": "code"},
    {"match": "fn", "as": "block", "kind": "footnote", "split": true, "anchor": {"attr": "id"}},
    {"match": "hr", "as": "break"},
    {"match": "ul", "as": "list", "ordered": false},
    {"match": "ol", "as": "list", "ordered": true},
    {"match": "li", "as": "item"},
    {"match": "dl", "as": "list", "ordered": false},
    {"match": "dt", "as": "item", "attrs": {"nitf.element": "dt"}},
    {"match": "dd", "as": "item", "attrs": {"nitf.element": "dd"}},

    {"match": "media", "as": "transparent", "mark": {"nitf.media_type": {"attr": "media-type"}, "nitf.style": {"attr": "style"}}},
    {"match": "media/media-reference", "as": "image", "id": {"attr": "source"}, "alt": {"attr": "alternate-text"},
      "attrs": {"mime-type": {"attr": "mime-type"}, "height": {"attr": "height"}, "width": {"attr": "width"}, "units": {"attr": "units"}, "name": {"attr": "name"}, "data-location": {"attr": "data-location"}, "coding": {"attr": "coding"}, "time": {"attr": "time"}, "time-unit-of-measure": {"attr": "time-unit-of-measure"}, "outcue": {"attr": "outcue"}, "source-credit": {"attr": "source-credit"}, "copyright": {"attr": "copyright"}}},
    {"match": "media/media-caption", "as": "block", "kind": "caption"},
    {"match": "media/media-producer", "as": "block", "kind": "paragraph", "attrs": {"nitf.field": "media-producer"}},
    {"match": "media/media-metadata", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "media/media-object", "as": "table", "pairs": "local", "header": ["name", "value"]},
    {"match": "img", "as": "image", "id": {"attr": "source"}, "alt": {"attr": "alt"}},

    {"match": "nitf-table", "as": "transparent", "anchor": {"attr": "id"}},
    {"match": "nitf-table/nitf-table-metadata", "as": "table", "pairs": "path", "header": ["name", "value"]},
    {"match": "table", "as": "table", "anchor": {"attr": "id"}, "attrs": {"nitf.class": {"attr": "class"}, "nitf.border": {"attr": "border"}, "nitf.summary": {"attr": "summary"}}},
    {"match": "table/caption", "as": "block", "kind": "caption"},
    {"match": "thead", "as": "transparent"},
    {"match": "tbody", "as": "transparent"},
    {"match": "tfoot", "as": "transparent"},
    {"match": "colgroup", "as": "transparent"},
    {"match": "col", "as": "transparent"},
    {"match": "tr", "as": "row"},
    {"match": "thead/tr", "as": "row", "header": true},
    {"match": "td", "as": "cell", "colspan": "colspan", "rowspan": "rowspan"},
    {"match": "th", "as": "cell", "header": true, "colspan": "colspan", "rowspan": "rowspan"},

    {"match": "em", "as": "inline", "style": "italic"},
    {"match": "strong", "as": "inline", "style": "bold"},
    {"match": "sub", "as": "inline", "style": "subscript"},
    {"match": "sup", "as": "inline", "style": "superscript"},
    {"match": "pronounce", "as": "inline"},
    {"match": "q", "as": "inline"},
    {"match": "a", "as": "inline", "link": {"attr": "href"}, "attrs": {"rel": {"attr": "rel"}, "rev": {"attr": "rev"}, "name": {"attr": "name"}}},
    {"match": "br", "as": "break"},
    {"match": "person", "as": "inline", "attrs": {"idsrc": {"attr": "idsrc"}, "value": {"attr": "value"}}},
    {"match": "name.given", "as": "inline"},
    {"match": "name.family", "as": "inline"},
    {"match": "function", "as": "inline", "attrs": {"idsrc": {"attr": "idsrc"}, "value": {"attr": "value"}}},
    {"match": "org", "as": "inline", "attrs": {"idsrc": {"attr": "idsrc"}, "value": {"attr": "value"}}},
    {"match": "location", "as": "inline", "attrs": {"location-code": {"attr": "location-code"}, "code-source": {"attr": "code-source"}}},
    {"match": "sublocation", "as": "inline", "attrs": {"location-code": {"attr": "location-code"}, "code-source": {"attr": "code-source"}}},
    {"match": "city", "as": "inline", "attrs": {"city-code": {"attr": "city-code"}, "code-source": {"attr": "code-source"}}},
    {"match": "state", "as": "inline", "attrs": {"state-code": {"attr": "state-code"}, "code-source": {"attr": "code-source"}}},
    {"match": "region", "as": "inline", "attrs": {"region-code": {"attr": "region-code"}, "code-source": {"attr": "code-source"}}},
    {"match": "country", "as": "inline", "attrs": {"iso-cc": {"attr": "iso-cc"}}},
    {"match": "chron", "as": "inline", "attrs": {"norm": {"attr": "norm"}}},
    {"match": "money", "as": "inline", "attrs": {"unit": {"attr": "unit"}, "date": {"attr": "date"}}},
    {"match": "num", "as": "inline", "attrs": {"units": {"attr": "units"}, "decimal-ch": {"attr": "decimal-ch"}, "thousands-ch": {"attr": "thousands-ch"}}},
    {"match": "frac", "as": "inline"},
    {"match": "frac-num", "as": "inline"},
    {"match": "frac-den", "as": "inline"},
    {"match": "sub-num", "as": "inline"},
    {"match": "event", "as": "inline", "attrs": {"idsrc": {"attr": "idsrc"}, "value": {"attr": "value"}, "start-date": {"attr": "start-date"}, "end-date": {"attr": "end-date"}}},
    {"match": "object.title", "as": "inline", "attrs": {"idsrc": {"attr": "idsrc"}, "value": {"attr": "value"}}},
    {"match": "alt-code", "as": "inline", "attrs": {"idsrc": {"attr": "idsrc"}, "value": {"attr": "value"}}},
    {"match": "virtloc", "as": "inline", "attrs": {"idsrc": {"attr": "idsrc"}, "value": {"attr": "value"}}},
    {"match": "classifier", "as": "inline", "attrs": {"classifier-type": {"attr": "type"}, "idsrc": {"attr": "idsrc"}, "value": {"attr": "value"}}},
    {"match": "copyrite", "as": "inline"},
    {"match": "copyrite.year", "as": "inline"},
    {"match": "copyrite.holder", "as": "inline"}
  ]
}
