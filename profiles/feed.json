{
  "profile": "feed",
  "title": "Web feeds: RSS 0.91 to 2.0, RSS 1.0 (RDF) and Atom 1.0, with Dublin Core, content, iTunes, Podcasting 2.0, Media RSS, GeoRSS, Slash and syndication extensions",
  "format": 1,
  "namespaces": {
    "a": "http://www.w3.org/2005/Atom",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "dc": "http://purl.org/dc/elements/1.1/",
    "content": "http://purl.org/rss/1.0/modules/content/",
    "itunes": "http://www.itunes.com/dtds/podcast-1.0.dtd",
    "podcast": "https://podcastindex.org/namespace/1.0",
    "media": "http://search.yahoo.com/mrss/",
    "georss": "http://www.georss.org/georss",
    "geo": "http://www.w3.org/2003/01/geo/wgs84_pos#",
    "slash": "http://purl.org/rss/1.0/modules/slash/",
    "sy": "http://purl.org/rss/1.0/modules/syndication/",
    "wfw": "http://wellformedweb.org/CommentAPI/",
    "psc": "http://podlove.org/simple-chapters",
    "thr": "http://purl.org/syndication/thread/1.0",
    "googleplay": "http://www.google.com/schemas/play-podcasts/1.0"
  },
  "namespace_aliases": {
    "http://purl.org/rss/1.0/": "",
    "https://www.w3.org/2005/Atom": "http://www.w3.org/2005/Atom",
    "https://purl.org/dc/elements/1.1/": "http://purl.org/dc/elements/1.1/",
    "https://purl.org/rss/1.0/modules/content/": "http://purl.org/rss/1.0/modules/content/",
    "https://purl.org/rss/1.0/modules/slash/": "http://purl.org/rss/1.0/modules/slash/",
    "https://purl.org/rss/1.0/modules/syndication/": "http://purl.org/rss/1.0/modules/syndication/",
    "https://search.yahoo.com/mrss/": "http://search.yahoo.com/mrss/",
    "https://wellformedweb.org/CommentAPI/": "http://wellformedweb.org/CommentAPI/"
  },
  "match": [
    {"root": "rss"},
    {"root": "feed", "namespace": "http://www.w3.org/2005/Atom"},
    {"root": "RDF", "namespace": "http://www.w3.org/1999/02/22-rdf-syntax-ns#", "declares": "http://purl.org/rss/1.0/"}
  ],
  "heading_base": 2,
  "rules": [
    {"match": "/rss", "as": "transparent", "extra": {"feed.version": {"attr": "version"}}},
    {"match": "/rdf:RDF", "as": "transparent"},
    {"match": "/a:feed", "as": "transparent"},
    {"match": "channel", "as": "transparent", "extra": {"feed.about": {"attr": "rdf:about"}}},

    {"match": "channel/title", "as": "metadata", "field": "title", "also_heading": 1},
    {"match": "channel/description", "as": "document", "media_type": "text/html", "when": "markup"},
    {"match": "channel/link", "as": "metadata", "field": "extra", "key": "feed.link"},
    {"match": "channel/language", "as": "metadata", "field": "language"},
    {"match": "channel/dc:language", "as": "metadata", "field": "language"},
    {"match": "channel/lastBuildDate", "as": "metadata", "field": "modified"},
    {"match": "channel/pubDate", "as": "metadata", "field": "created"},
    {"match": "channel/dc:date", "as": "metadata", "field": "modified"},
    {"match": "channel/generator", "as": "metadata", "field": "extra", "key": "feed.generator"},
    {"match": "channel/copyright", "as": "metadata", "field": "extra", "key": "feed.rights"},
    {"match": "channel/dc:rights", "as": "metadata", "field": "extra", "key": "feed.rights"},
    {"match": "channel/managingEditor", "as": "metadata", "field": "extra", "key": "feed.managing_editor"},
    {"match": "channel/webMaster", "as": "metadata", "field": "extra", "key": "feed.webmaster"},
    {"match": "channel/docs", "as": "metadata", "field": "extra", "key": "feed.docs"},
    {"match": "channel/ttl", "as": "metadata", "field": "extra", "key": "feed.ttl"},
    {"match": "channel/category", "as": "metadata", "field": "keyword"},
    {"match": "channel/dc:subject", "as": "metadata", "field": "subject"},
    {"match": "channel/dc:creator", "as": "metadata", "field": "author"},
    {"match": "channel/dc:publisher", "as": "metadata", "field": "extra", "key": "feed.publisher"},
    {"match": "channel/dc:source", "as": "metadata", "field": "extra", "key": "feed.source"},
    {"match": "channel/sy:updatePeriod", "as": "metadata", "field": "extra", "key": "feed.update_period"},
    {"match": "channel/sy:updateFrequency", "as": "metadata", "field": "extra", "key": "feed.update_frequency"},
    {"match": "channel/sy:updateBase", "as": "metadata", "field": "extra", "key": "feed.update_base"},
    {"match": "channel/items", "as": "transparent"},
    {"match": "channel/items/rdf:Seq", "as": "transparent"},
    {"match": "rdf:Seq/rdf:li", "as": "note", "type": "attribute", "value": {"attr": "rdf:resource"}, "attrs": {"feed.field": "items"}},
    {"match": "channel/image[@rdf:resource]", "as": "note", "type": "attribute", "value": {"attr": "rdf:resource"}, "attrs": {"feed.field": "image"}},
    {"match": "channel/textinput[@rdf:resource]", "as": "note", "type": "attribute", "value": {"attr": "rdf:resource"}, "attrs": {"feed.field": "textinput"}},
    {"match": "image", "as": "image", "id": {"child": "url"}, "alt": {"child": "title"}, "anchor": {"attr": "rdf:about"}, "attrs": {"feed.link": {"child": "link"}, "feed.width": {"child": "width"}, "feed.height": {"child": "height"}, "feed.description": {"child": "description"}}},

    {"match": "channel/itunes:summary", "as": "document", "media_type": "text/html", "when": "markup"},
    {"match": "channel/itunes:subtitle", "as": "block", "kind": "paragraph", "attrs": {"feed.field": "itunes:subtitle"}},
    {"match": "channel/itunes:author", "as": "metadata", "field": "author"},
    {"match": "channel/itunes:keywords", "as": "metadata", "field": "extra", "key": "feed.itunes_keywords"},
    {"match": "channel/itunes:explicit", "as": "metadata", "field": "extra", "key": "feed.itunes_explicit"},
    {"match": "channel/itunes:type", "as": "metadata", "field": "extra", "key": "feed.itunes_type"},
    {"match": "channel/itunes:new-feed-url", "as": "metadata", "field": "extra", "key": "feed.itunes_new_feed_url"},
    {"match": "channel/itunes:owner", "as": "transparent"},
    {"match": "itunes:owner/itunes:name", "as": "metadata", "field": "extra", "key": "feed.itunes_owner_name"},
    {"match": "itunes:owner/itunes:email", "as": "metadata", "field": "extra", "key": "feed.itunes_owner_email"},
    {"match": "channel/itunes:category", "as": "metadata", "field": "keyword", "value": {"attr": "text"}},
    {"match": "itunes:category/itunes:category", "as": "metadata", "field": "keyword", "value": {"attr": "text"}},
    {"match": "itunes:image", "as": "image", "id": {"attr": "href"}},
    {"match": "channel/googleplay:author", "as": "metadata", "field": "author"},
    {"match": "channel/googleplay:description", "as": "document", "media_type": "text/html", "when": "markup"},
    {"match": "channel/googleplay:email", "as": "metadata", "field": "extra", "key": "feed.googleplay_email"},

    {"match": "a:feed/a:title", "as": "metadata", "field": "title", "also_heading": 1},
    {"match": "a:feed/a:subtitle", "as": "document", "media_type": {"attr": "type", "map": {"html": "text/html", "xhtml": "application/xhtml+xml"}}},
    {"match": "a:feed/a:subtitle", "as": "block", "kind": "paragraph"},
    {"match": "a:feed/a:id", "as": "metadata", "field": "extra", "key": "feed.id"},
    {"match": "a:feed/a:updated", "as": "metadata", "field": "modified"},
    {"match": "a:feed/a:rights", "as": "metadata", "field": "extra", "key": "feed.rights"},
    {"match": "a:feed/a:generator", "as": "metadata", "field": "extra", "key": "feed.generator", "extra": {"feed.generator_uri": {"attr": "uri"}, "feed.generator_version": {"attr": "version"}}},
    {"match": "a:feed/a:icon", "as": "metadata", "field": "extra", "key": "feed.icon"},
    {"match": "a:feed/a:logo", "as": "metadata", "field": "extra", "key": "feed.logo"},
    {"match": "a:feed/a:author", "as": "metadata", "field": "author", "value": {"child": "a:name"}, "extra": {"feed.author_uri": {"child": "a:uri"}, "feed.author_email": {"child": "a:email"}}},
    {"match": "a:feed/a:contributor", "as": "metadata", "field": "extra", "key": "feed.contributor", "value": {"child": "a:name"}},
    {"match": "a:feed/a:category", "as": "metadata", "field": "keyword", "value": {"attr": "term"}},

    {"match": "item[@rdf:about]", "as": "section", "anchor": {"attr": "rdf:about"}, "attrs": {"feed.link": {"child": "link"}, "feed.published": {"child": "pubDate"}, "feed.date": {"child": "dc:date"}}},
    {"match": "item", "as": "section", "anchor": {"child": "guid"},
      "attrs": {"feed.guid_is_permalink": {"attr": "isPermaLink", "child": "guid"}, "feed.link": {"child": "link"}, "feed.published": {"child": "pubDate"}, "feed.date": {"child": "dc:date"},
        "feed.itunes_duration": {"child": "itunes:duration"}, "feed.itunes_episode": {"child": "itunes:episode"}, "feed.itunes_season": {"child": "itunes:season"}, "feed.itunes_episode_type": {"child": "itunes:episodeType"}, "feed.itunes_explicit": {"child": "itunes:explicit"}, "feed.itunes_block": {"child": "itunes:block"},
        "feed.georss_point": {"child": "georss:point"}, "feed.geo_lat": {"child": "geo:Point/geo:lat"}, "feed.geo_long": {"child": "geo:Point/geo:long"}}},
    {"match": "item/title", "as": "heading", "level": "nesting"},
    {"match": "item/description", "as": "document", "media_type": "text/html", "when": "markup"},
    {"match": "item/content:encoded", "as": "document", "media_type": "text/html", "when": "markup"},
    {"match": "item/link", "as": "block", "kind": "paragraph","attrs": {"feed.field": "link"}},
    {"match": "item/guid", "as": "block", "kind": "paragraph","attrs": {"feed.field": "guid"}},
    {"match": "item/pubDate", "as": "block", "kind": "paragraph","attrs": {"feed.field": "pubDate"}},
    {"match": "item/comments", "as": "block", "kind": "paragraph","attrs": {"feed.field": "comments"}},
    {"match": "item/author", "as": "block", "kind": "paragraph","attrs": {"feed.field": "author"}},
    {"match": "item/category", "as": "block", "kind": "paragraph","attrs": {"feed.field": "category", "feed.domain": {"attr": "domain"}}},
    {"match": "item/source", "as": "block", "kind": "paragraph","attrs": {"feed.field": "source", "feed.url": {"attr": "url"}}},
    {"match": "item/enclosure", "as": "note", "type": "attribute", "value": {"attr": "url"}, "attrs": {"feed.field": "enclosure", "feed.type": {"attr": "type"}, "feed.length": {"attr": "length"}}},
    {"match": "geo:Point", "as": "transparent"},

    {"match": "dc:creator", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:creator"}},
    {"match": "dc:contributor", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:contributor"}},
    {"match": "dc:subject", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:subject"}},
    {"match": "dc:date", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:date"}},
    {"match": "dc:identifier", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:identifier"}},
    {"match": "dc:publisher", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:publisher"}},
    {"match": "dc:rights", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:rights"}},
    {"match": "dc:source", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:source"}},
    {"match": "dc:type", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:type"}},
    {"match": "dc:format", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:format"}},
    {"match": "dc:language", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:language"}},
    {"match": "dc:relation", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:relation"}},
    {"match": "dc:coverage", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:coverage"}},
    {"match": "dc:title", "as": "block", "kind": "paragraph","attrs": {"feed.field": "dc:title"}},
    {"match": "dc:description", "as": "document", "media_type": "text/html", "when": "markup"},

    {"match": "itunes:summary", "as": "document", "media_type": "text/html", "when": "markup"},
    {"match": "itunes:subtitle", "as": "block", "kind": "paragraph", "attrs": {"feed.field": "itunes:subtitle"}},
    {"match": "itunes:title", "as": "block", "kind": "paragraph","attrs": {"feed.field": "itunes:title"}},
    {"match": "itunes:author", "as": "block", "kind": "paragraph","attrs": {"feed.field": "itunes:author"}},
    {"match": "itunes:keywords", "as": "block", "kind": "paragraph","attrs": {"feed.field": "itunes:keywords"}},
    {"match": "item/itunes:duration", "as": "block", "kind": "paragraph","attrs": {"feed.field": "itunes:duration"}},
    {"match": "item/itunes:episode", "as": "block", "kind": "paragraph","attrs": {"feed.field": "itunes:episode"}},
    {"match": "item/itunes:episodeType", "as": "block", "kind": "paragraph","attrs": {"feed.field": "itunes:episodeType"}},
    {"match": "item/itunes:explicit", "as": "block", "kind": "paragraph","attrs": {"feed.field": "itunes:explicit"}},

    {"match": "podcast:transcript", "as": "note", "type": "attribute", "value": {"attr": "url"}, "attrs": {"feed.field": "podcast:transcript", "feed.type": {"attr": "type"}, "feed.language": {"attr": "language"}, "feed.rel": {"attr": "rel"}}},
    {"match": "podcast:chapters", "as": "note", "type": "attribute", "value": {"attr": "url"}, "attrs": {"feed.field": "podcast:chapters", "feed.type": {"attr": "type"}}},
    {"match": "podcast:person", "as": "block", "kind": "paragraph","attrs": {"feed.field": "podcast:person", "feed.role": {"attr": "role"}, "feed.group": {"attr": "group"}, "feed.href": {"attr": "href"}, "feed.img": {"attr": "img"}}},
    {"match": "podcast:funding", "as": "block", "kind": "paragraph","attrs": {"feed.field": "podcast:funding", "feed.url": {"attr": "url"}}},
    {"match": "podcast:socialInteract", "as": "note", "type": "attribute", "value": {"attr": "uri"}, "attrs": {"feed.field": "podcast:socialInteract", "feed.protocol": {"attr": "protocol"}}},
    {"match": "psc:chapters", "as": "list", "attrs": {"feed.field": "psc:chapters", "feed.version": {"attr": "version"}}},
    {"match": "psc:chapter", "as": "item", "value": {"attr": "title"}, "attrs": {"feed.start": {"attr": "start"}, "feed.href": {"attr": "href"}, "feed.image": {"attr": "image"}}},

    {"match": "media:group", "as": "transparent"},
    {"match": "media:content", "as": "note", "type": "attribute", "value": {"attr": "url"}, "attrs": {"feed.field": "media:content", "feed.type": {"attr": "type"}, "feed.medium": {"attr": "medium"}, "feed.width": {"attr": "width"}, "feed.height": {"attr": "height"}, "feed.file_size": {"attr": "fileSize"}, "feed.duration": {"attr": "duration"}, "feed.lang": {"attr": "lang"}}},
    {"match": "media:thumbnail", "as": "image", "id": {"attr": "url"}, "attrs": {"feed.width": {"attr": "width"}, "feed.height": {"attr": "height"}}},
    {"match": "media:description", "as": "document", "media_type": {"attr": "type", "map": {"html": "text/html"}}},
    {"match": "media:description", "as": "document", "media_type": "text/html", "when": "markup"},
    {"match": "media:title", "as": "block", "kind": "paragraph","attrs": {"feed.field": "media:title"}},
    {"match": "media:text", "as": "block", "kind": "paragraph", "attrs": {"feed.field": "media:text"}},
    {"match": "media:credit", "as": "block", "kind": "paragraph","attrs": {"feed.field": "media:credit", "feed.role": {"attr": "role"}, "feed.scheme": {"attr": "scheme"}}},
    {"match": "media:keywords", "as": "block", "kind": "paragraph","attrs": {"feed.field": "media:keywords"}},
    {"match": "media:rating", "as": "block", "kind": "paragraph","attrs": {"feed.field": "media:rating", "feed.scheme": {"attr": "scheme"}}},

    {"match": "slash:comments", "as": "block", "kind": "paragraph","attrs": {"feed.field": "slash:comments"}},
    {"match": "slash:department", "as": "block", "kind": "paragraph","attrs": {"feed.field": "slash:department"}},
    {"match": "slash:section", "as": "block", "kind": "paragraph","attrs": {"feed.field": "slash:section"}},
    {"match": "slash:hit_parade", "as": "block", "kind": "paragraph","attrs": {"feed.field": "slash:hit_parade"}},
    {"match": "wfw:commentRss", "as": "block", "kind": "paragraph","attrs": {"feed.field": "wfw:commentRss"}},
    {"match": "thr:total", "as": "block", "kind": "paragraph","attrs": {"feed.field": "thr:total"}},

    {"match": "a:entry", "as": "section", "anchor": {"child": "a:id"}, "attrs": {"feed.published": {"child": "a:published"}, "feed.updated": {"child": "a:updated"}}},
    {"match": "a:entry/a:title", "as": "heading", "level": "nesting"},
    {"match": "a:entry/a:title[@type='html']", "as": "heading", "level": "nesting", "attrs": {"media_type": "text/html"}},
    {"match": "a:entry/a:title[@type='xhtml']", "as": "heading", "level": "nesting", "attrs": {"media_type": "application/xhtml+xml"}},
    {"match": "a:content", "as": "document", "media_type": {"attr": "type", "map": {"html": "text/html", "xhtml": "application/xhtml+xml"}}},
    {"match": "a:content", "as": "block", "kind": "paragraph", "attrs": {"feed.type": {"attr": "type"}}},
    {"match": "a:content[@src]", "as": "note", "type": "attribute", "value": {"attr": "src"}, "attrs": {"feed.field": "content", "feed.type": {"attr": "type"}}},
    {"match": "a:summary", "as": "document", "media_type": {"attr": "type", "map": {"html": "text/html", "xhtml": "application/xhtml+xml"}}},
    {"match": "a:summary", "as": "block", "kind": "paragraph"},
    {"match": "a:rights", "as": "document", "media_type": {"attr": "type", "map": {"html": "text/html", "xhtml": "application/xhtml+xml"}}},
    {"match": "a:rights", "as": "block", "kind": "paragraph","attrs": {"feed.field": "rights"}},
    {"match": "a:entry/a:id", "as": "block", "kind": "paragraph","attrs": {"feed.field": "id"}},
    {"match": "a:entry/a:published", "as": "block", "kind": "paragraph","attrs": {"feed.field": "published"}},
    {"match": "a:entry/a:updated", "as": "block", "kind": "paragraph","attrs": {"feed.field": "updated"}},
    {"match": "a:updated", "as": "block", "kind": "paragraph","attrs": {"feed.field": "updated"}},
    {"match": "a:author", "as": "block", "kind": "paragraph","value": {"child": "a:name"}, "attrs": {"feed.field": "author", "feed.uri": {"child": "a:uri"}, "feed.email": {"child": "a:email"}}},
    {"match": "a:contributor", "as": "block", "kind": "paragraph","value": {"child": "a:name"}, "attrs": {"feed.field": "contributor", "feed.uri": {"child": "a:uri"}, "feed.email": {"child": "a:email"}}},
    {"match": "a:category", "as": "note", "type": "attribute", "value": {"attr": "term"}, "attrs": {"feed.field": "category", "feed.scheme": {"attr": "scheme"}, "feed.label": {"attr": "label"}}},
    {"match": "a:link", "as": "note", "type": "attribute", "value": {"attr": "href"}, "attrs": {"feed.field": "link", "feed.rel": {"attr": "rel"}, "feed.type": {"attr": "type"}, "feed.title": {"attr": "title"}, "feed.hreflang": {"attr": "hreflang"}, "feed.length": {"attr": "length"}}}
  ]
}
