{
  "profile": "formex",
  "title": "EUR-Lex Formex 4 (Publications Office of the EU): acts, annexes and their bibliographic records",
  "format": 1,
  "match": [
    {"root": "ACT"}, {"root": "ANNEX"}, {"root": "DOC"}, {"root": "PUBLICATION"},
    {"root": "CONS.ACT"}, {"root": "CONS.ANNEX"}, {"root": "CONS.OTH"}, {"root": "GENERAL"}
  ],
  "heading_base": 2,
  "rules": [
    {"match": "/ACT", "as": "transparent", "extra": {"fx.root": "ACT", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/ANNEX", "as": "transparent", "extra": {"fx.root": "ANNEX", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/DOC", "as": "transparent", "extra": {"fx.root": "DOC", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/PUBLICATION", "as": "transparent", "extra": {"fx.root": "PUBLICATION", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/CONS.ACT", "as": "transparent", "extra": {"fx.root": "CONS.ACT", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/CONS.ANNEX", "as": "transparent", "extra": {"fx.root": "CONS.ANNEX", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/CONS.OTH", "as": "transparent", "extra": {"fx.root": "CONS.OTH", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/GENERAL", "as": "transparent", "extra": {"fx.root": "GENERAL", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/CONS.DOC", "as": "transparent", "extra": {"fx.root": "CONS.DOC", "fx.nnc": {"attr": "NNC"}}},
    {"match": "/CONS.DOC.GEN", "as": "transparent", "extra": {"fx.root": "CONS.DOC.GEN", "fx.nnc": {"attr": "NNC"}}},
    {"match": "BIB.INSTANCE", "as": "transparent"},
    {"match": "BIB.INSTANCE/DOCUMENT.REF", "as": "transparent", "extra": {"fx.document_ref": {"attr": "FILE"}}},
    {"match": "DOCUMENT.REF/COLL", "as": "metadata", "field": "extra", "key": "fx.oj.coll"},
    {"match": "DOCUMENT.REF/NO.OJ", "as": "metadata", "field": "extra", "key": "fx.oj.no.oj"},
    {"match": "DOCUMENT.REF/YEAR", "as": "metadata", "field": "extra", "key": "fx.oj.year"},
    {"match": "DOCUMENT.REF/LG.OJ", "as": "metadata", "field": "extra", "key": "fx.oj.lg.oj"},
    {"match": "DOCUMENT.REF/PAGE.FIRST", "as": "metadata", "field": "extra", "key": "fx.oj.page.first"},
    {"match": "DOCUMENT.REF/PAGE.SEQ", "as": "metadata", "field": "extra", "key": "fx.oj.page.seq"},
    {"match": "DOCUMENT.REF/VOLUME.REF", "as": "metadata", "field": "extra", "key": "fx.oj.volume.ref"},
    {"match": "BIB.INSTANCE/DATE", "as": "metadata", "field": "extra", "key": "fx.date", "extra": {"fx.date_iso": {"attr": "ISO"}}},
    {"match": "BIB.INSTANCE/LG.DOC", "as": "metadata", "field": "language"},
    {"match": "BIB.INSTANCE/NO.SEQ", "as": "metadata", "field": "extra", "key": "fx.no.seq"},
    {"match": "BIB.INSTANCE/PAGE.FIRST", "as": "metadata", "field": "extra", "key": "fx.page.first"},
    {"match": "BIB.INSTANCE/PAGE.SEQ", "as": "metadata", "field": "extra", "key": "fx.page.seq"},
    {"match": "BIB.INSTANCE/PAGE.LAST", "as": "metadata", "field": "extra", "key": "fx.page.last"},
    {"match": "BIB.INSTANCE/PAGE.TOTAL", "as": "metadata", "field": "extra", "key": "fx.page.total"},
    {"match": "BIB.INSTANCE/NO.DOC", "as": "metadata", "field": "extra", "key": "fx.no.doc"},
    {"match": "BIB.INSTANCE/NO.CELEX", "as": "metadata", "field": "extra", "key": "fx.no.celex"},
    {"match": "BIB.INSTANCE/NO.DOC.C", "as": "metadata", "field": "extra", "key": "fx.no.doc.c"},
    {"match": "BIB.INSTANCE/NO.DOC", "as": "metadata", "field": "extra", "key": "fx.no.doc", "extra": {"fx.no.doc.type": {"attr": "TYPE"}, "fx.no.doc.format": {"attr": "FORMAT"}}},
    {"match": "BIB.DOC", "as": "transparent"},
    {"match": "BIB.DOC/NO.DOC", "as": "transparent", "extra": {"fx.no.doc.type": {"attr": "TYPE"}, "fx.no.doc.format": {"attr": "FORMAT"}}},
    {"match": "NO.DOC/NO.CURRENT", "as": "metadata", "field": "extra", "key": "fx.no.doc.no.current"},
    {"match": "NO.DOC/YEAR", "as": "metadata", "field": "extra", "key": "fx.no.doc.year"},
    {"match": "NO.DOC/COM", "as": "metadata", "field": "extra", "key": "fx.no.doc.com"},
    {"match": "BIB.DOC/DURAB", "as": "metadata", "field": "extra", "key": "fx.durab", "value": {"attr": "TYPE"}},
    {"match": "BIB.DOC/AUTHOR", "as": "metadata", "field": "author"},
    {"match": "BIB.DOC/PROD.ID", "as": "metadata", "field": "extra", "key": "fx.prod_id"},
    {"match": "BIB.DOC/FIN.ID", "as": "metadata", "field": "extra", "key": "fx.fin_id"},
    {"match": "EEA","as": "metadata", "field": "extra", "key": "fx.eea", "value": "EEA"},
    {"match": "PUBLICATION.REF", "as": "transparent", "extra": {"fx.publication_ref": {"attr": "FILE"}}},
    {"match": "PUBLICATION.REF/COLL", "as": "metadata", "field": "extra", "key": "fx.oj.coll"},
    {"match": "PUBLICATION.REF/NO.OJ", "as": "metadata", "field": "extra", "key": "fx.oj.no.oj"},
    {"match": "PUBLICATION.REF/LG.OJ", "as": "metadata", "field": "extra", "key": "fx.oj.lg.oj"},
    {"match": "PUBLICATION.REF/VOLUME.REF", "as": "metadata", "field": "extra", "key": "fx.oj.volume.ref"},
    {"match": "PUBLICATION.REF/DATE", "as": "metadata", "field": "extra", "key": "fx.oj.date", "extra": {"fx.oj.date_iso": {"attr": "ISO"}}},
    {"match": "FMX", "as": "transparent"},
    {"match": "DOC.MAIN.PUB", "as": "transparent", "extra": {"fx.main.no_seq": {"attr": "NO.SEQ"}, "fx.main.synoptism": {"attr": "SYNOPTISM"}, "fx.main.type": {"attr": "TYPE"}, "fx.main.in_summary": {"attr": "IN.SUMMARY"}}},
    {"match": "DOC.MAIN.PUB/LG.DOC", "as": "metadata", "field": "extra", "key": "fx.main.lg.doc"},
    {"match": "DOC.MAIN.PUB/LEGAL.VALUE", "as": "metadata", "field": "extra", "key": "fx.main.legal.value"},
    {"match": "DOC.MAIN.PUB/NO.CELEX", "as": "metadata", "field": "extra", "key": "fx.main.no.celex"},
    {"match": "DOC.MAIN.PUB/PAGE.FIRST", "as": "metadata", "field": "extra", "key": "fx.main.page.first"},
    {"match": "DOC.MAIN.PUB/PAGE.LAST", "as": "metadata", "field": "extra", "key": "fx.main.page.last"},
    {"match": "DOC.MAIN.PUB/PAGE.TOTAL", "as": "metadata", "field": "extra", "key": "fx.main.page.total"},
    {"match": "DOC.MAIN.PUB/PAGE.SEQ", "as": "metadata", "field": "extra", "key": "fx.main.page.seq"},
    {"match": "DOC.MAIN.PUB/NO.SEQ", "as": "metadata", "field": "extra", "key": "fx.main.no.seq"},
    {"match": "DOC.MAIN.PUB/DATE", "as": "metadata", "field": "extra", "key": "fx.main.date", "extra": {"fx.main.date_iso": {"attr": "ISO"}}},
    {"match": "DOC.MAIN.PUB/REF.PHYS", "as": "metadata", "field": "extra", "key": "fx.main.file", "value": {"attr": "FILE"}, "extra": {"fx.main.file_type": {"attr": "TYPE"}}},
    {"match": "DOC.SUB.PUB", "as": "transparent", "extra": {"fx.sub.no_seq": {"attr": "NO.SEQ"}, "fx.sub.synoptism": {"attr": "SYNOPTISM"}, "fx.sub.type": {"attr": "TYPE"}, "fx.sub.in_summary": {"attr": "IN.SUMMARY"}}},
    {"match": "DOC.SUB.PUB/LG.DOC", "as": "metadata", "field": "extra", "key": "fx.sub.lg.doc"},
    {"match": "DOC.SUB.PUB/LEGAL.VALUE", "as": "metadata", "field": "extra", "key": "fx.sub.legal.value"},
    {"match": "DOC.SUB.PUB/NO.CELEX", "as": "metadata", "field": "extra", "key": "fx.sub.no.celex"},
    {"match": "DOC.SUB.PUB/PAGE.FIRST", "as": "metadata", "field": "extra", "key": "fx.sub.page.first"},
    {"match": "DOC.SUB.PUB/PAGE.LAST", "as": "metadata", "field": "extra", "key": "fx.sub.page.last"},
    {"match": "DOC.SUB.PUB/PAGE.TOTAL", "as": "metadata", "field": "extra", "key": "fx.sub.page.total"},
    {"match": "DOC.SUB.PUB/PAGE.SEQ", "as": "metadata", "field": "extra", "key": "fx.sub.page.seq"},
    {"match": "DOC.SUB.PUB/NO.SEQ", "as": "metadata", "field": "extra", "key": "fx.sub.no.seq"},
    {"match": "DOC.SUB.PUB/DATE", "as": "metadata", "field": "extra", "key": "fx.sub.date", "extra": {"fx.sub.date_iso": {"attr": "ISO"}}},
    {"match": "DOC.SUB.PUB/REF.PHYS", "as": "metadata", "field": "extra", "key": "fx.sub.file", "value": {"attr": "FILE"}, "extra": {"fx.sub.file_type": {"attr": "TYPE"}}},
    {"match": "PAPER", "as": "transparent"},
    {"match": "VOLUME.PAPER", "as": "transparent"},
    {"match": "ITEM.VOLUME", "as": "transparent", "extra": {"fx.item_volume": {"attr": "REF.NO.SEQ"}}},
    {"match": "PDF", "as": "transparent"},
    {"match": "PDF/ITEM.VOLUME/TITLE", "as": "transparent", "extra": {"fx.pdf_title_ref": {"attr": "REF.TITLE"}}},
    {"match": "PDF/ITEM.VOLUME/ITEM.REF", "as": "metadata", "field": "extra", "key": "fx.pdf_page", "extra": {"fx.pdf": {"attr": "REF.PDF"}, "fx.doi": {"attr": "DOI.DOC"}}},
    {"match": "VOLUME.PAPER/ITEM.VOLUME/ITEM.REF", "as": "metadata", "field": "extra", "key": "fx.page", "extra": {"fx.pdf": {"attr": "REF.PDF"}, "fx.doi": {"attr": "DOI.DOC"}}},
    {"match": "TITLE", "as": "transparent", "anchor": {"attr": "ID.TITLE"}},
    {"match": "/*/TITLE/TI", "as": "heading", "level": 1},
    {"match": "ITEM.VOLUME/TITLE/TI", "as": "heading", "level": 1},
    {"match": "TI", "as": "heading", "level": "nesting"},
    {"match": "STI", "as": "block", "kind": "paragraph", "attrs": {"fx.element": "STI"}},
    {"match": "GR.SEQ", "as": "section", "attrs": {"fx.level": {"attr": "LEVEL"}}},
    {"match": "DIVISION", "as": "section"},
    {"match": "CONTENTS", "as": "transparent"},
    {"match": "SECTION", "as": "section", "attrs": {"fx.type": {"attr": "TYPE"}}},
    {"match": "/*/PREAMBLE", "as": "part", "kind": "chapter", "name": "PREAMBLE"},
    {"match": "/*/ENACTING.TERMS", "as": "part", "kind": "body", "name": "ENACTING.TERMS"},
    {"match": "/*/FINAL", "as": "part", "kind": "chapter", "name": "FINAL"},
    {"match": "PREAMBLE", "as": "transparent"},
    {"match": "ENACTING.TERMS", "as": "transparent"},
    {"match": "FINAL", "as": "transparent"},
    {"match": "PREAMBLE.INIT", "as": "block", "kind": "paragraph", "attrs": {"fx.element": "PREAMBLE.INIT"}},
    {"match": "PREAMBLE.FINAL", "as": "block", "kind": "paragraph", "attrs": {"fx.element": "PREAMBLE.FINAL"}},
    {"match": "GR.CONSID.INIT", "as": "block", "kind": "paragraph", "attrs": {"fx.element": "GR.CONSID.INIT"}},
    {"match": "VISA", "as": "block", "kind": "paragraph", "attrs": {"fx.element": "VISA"}},
    {"match": "PL.DATE", "as": "block", "kind": "paragraph", "attrs": {"fx.element": "PL.DATE"}},
    {"match": "GR.VISA", "as": "transparent"},
    {"match": "GR.CONSID", "as": "list", "ordered": false, "attrs": {"fx.element": "GR.CONSID"}},
    {"match": "CONSID", "as": "item"},
    {"match": "ARTICLE", "as": "section", "anchor": {"attr": "IDENTIFIER"}},
    {"match": "TI.ART", "as": "heading", "level": "nesting"},
    {"match": "STI.ART", "as": "block", "kind": "paragraph", "attrs": {"fx.element": "STI.ART"}},
    {"match": "PARAG", "as": "transparent", "anchor": {"attr": "IDENTIFIER"}},
    {"match": "NO.PARAG", "as": "label"},
    {"match": "ALINEA", "as": "block", "kind": "paragraph"},
    {"match": "SIGNATURE", "as": "transparent"},
    {"match": "SIGNATORY", "as": "transparent"},
    {"match": "P", "as": "block", "kind": "paragraph"},
    {"match": "LIST", "as": "list", "ordered": false, "mark": {"fx.list_type": {"attr": "TYPE"}}},
    {"match": "ITEM", "as": "item"},
    {"match": "NP", "as": "transparent"},
    {"match": "NO.P", "as": "label"},
    {"match": "TXT", "as": "block", "kind": "paragraph"},
    {"match": "DLIST", "as": "list", "ordered": false, "attrs": {"fx.dlist_type": {"attr": "TYPE"}, "fx.separator": {"attr": "SEPARATOR"}}},
    {"match": "DLIST.ITEM", "as": "item"},
    {"match": "TERM", "as": "inline", "style": "bold"},
    {"match": "DEFINITION", "as": "transparent"},
    {"match": "QUOT.S", "as": "block", "kind": "quote", "attrs": {"fx.level": {"attr": "LEVEL"}}},
    {"match": "GR.TBL", "as": "transparent"},
    {"match": "TBL", "as": "table", "anchor": {"attr": "NO.SEQ"}, "attrs": {"fx.cols": {"attr": "COLS"}}},
    {"match": "TBL/TITLE", "as": "block", "kind": "caption"},
    {"match": "CORPUS", "as": "transparent"},
    {"match": "ROW", "as": "row", "header": {"attr": "TYPE", "in": ["HEADER"]}},
    {"match": "CELL", "as": "cell", "header": {"attr": "TYPE", "in": ["HEADER"]}, "colspan": "COLSPAN", "rowspan": "ROWSPAN"},
    {"match": "NOTE", "as": "block", "kind": "footnote", "out_of_line": true, "anchor": {"attr": "NOTE.ID"}, "attrs": {"fx.note_type": {"attr": "TYPE"}, "fx.numbering": {"attr": "NUMBERING"}, "fx.numbering_continued": {"attr": "NUMBERING.CONTINUED"}, "fx.note_ref": {"attr": "NOTE.REF"}}},
    {"match": "GR.NOTES", "as": "transparent"},
    {"match": "GR.ANNOTATION", "as": "transparent"},
    {"match": "ANNOTATION", "as": "block", "kind": "paragraph", "attrs": {"fx.element": "ANNOTATION"}},
    {"match": "IMG.CNT", "as": "transparent"},
    {"match": "INCL.ELEMENT", "as": "image", "id": {"attr": "FILEREF"}, "attrs": {"fx.type": {"attr": "TYPE"}, "fx.content": {"attr": "CONTENT"}}},
    {"match": "FORMULA.S", "as": "transparent", "attrs": {"fx.element": "FORMULA.S"}},
    {"match": "HT[@TYPE='BOLD']", "as": "inline", "style": "bold"},
    {"match": "HT[@TYPE='ITALIC']", "as": "inline", "style": "italic"},
    {"match": "HT[@TYPE='SUP']", "as": "inline", "style": "superscript"},
    {"match": "HT[@TYPE='SUB']", "as": "inline", "style": "subscript"},
    {"match": "HT", "as": "inline"},
    {"match": "FT[@TYPE='CODE']", "as": "inline", "style": "code"},
    {"match": "FT", "as": "inline"},
    {"match": "DATE", "as": "inline"},
    {"match": "REF.DOC.OJ", "as": "inline"},
    {"match": "IE", "as": "inline"},
    {"match": "EXPR", "as": "inline"},
    {"match": "IND", "as": "inline"},
    {"match": "QUOT.START", "as": "inline"},
    {"match": "QUOT.END", "as": "inline"},
    {"match": "OVER", "as": "inline"},
    {"match": "PREFIX", "as": "inline"},
    {"match": "ADDR.S", "as": "inline"},
    {"match": "LINK", "as": "inline"},
    {"match": "TXT.COL", "as": "inline"}
  ]
}
