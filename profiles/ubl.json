{
  "profile": "ubl",
  "title": "OASIS UBL 2.x Invoice and CreditNote (Peppol BIS Billing 3.0, EN 16931, XRechnung UBL)",
  "format": 1,
  "namespaces": {
    "inv": "urn:oasis:names:specification:ubl:schema:xsd:Invoice-2",
    "cn": "urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2",
    "cac": "urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2",
    "cbc": "urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
  },
  "default_namespace": "urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2",
  "match": [
    {"root": "Invoice", "namespace": "urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"},
    {"root": "CreditNote", "namespace": "urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2"}
  ],
  "heading_base": 1,
  "notes": "See profiles/ubl.md. Values are as written; amounts keep their currencyID, codes their schemeID or listID. The cac/cbc rules are not tied to the root, so that other UBL documents can reuse them.",
  "rules": [
    {"match": "/inv:Invoice", "as": "table", "note": "UBL has no element around the lines: the document is the lines table; its other content is read as blocks",
      "header": ["line id", "item name", "description", "quantity", "net price", "line net amount", "VAT category", "VAT rate", "note", "item identifiers", "item classification", "item attributes", "billing period", "other"]},
    {"match": "/cn:CreditNote", "as": "table",
      "header": ["line id", "item name", "description", "quantity", "net price", "line net amount", "VAT category", "VAT rate", "note", "item identifiers", "item classification", "item attributes", "billing period", "other"]},
    {"match": "/*/UBLVersionID", "as": "metadata", "field": "extra", "key": "inv.ubl_version"},
    {"match": "/*/CustomizationID", "as": "metadata", "field": "extra", "key": "inv.customization_id", "extra": {"inv.customization_scheme": {"attr": "schemeID"}}},
    {"match": "/*/ProfileID", "as": "metadata", "field": "extra", "key": "inv.profile_id", "extra": {"inv.profile_scheme": {"attr": "schemeID"}}},
    {"match": "/*/ProfileExecutionID", "as": "metadata", "field": "extra", "key": "inv.profile_execution_id"},
    {"match": "/*/ID", "as": "metadata", "field": "extra", "key": "inv.number", "extra": {"inv.number_scheme": {"attr": "schemeID"}}},
    {"match": "/*/UUID", "as": "metadata", "field": "extra", "key": "inv.uuid"},
    {"match": "/*/CopyIndicator", "as": "metadata", "field": "extra", "key": "inv.copy_indicator"},
    {"match": "/*/IssueDate", "as": "metadata", "field": "created"},
    {"match": "/*/IssueTime", "as": "metadata", "field": "extra", "key": "inv.issue_time"},
    {"match": "/*/InvoiceTypeCode", "as": "metadata", "field": "extra", "key": "inv.type_code", "extra": {"inv.type_code_list": {"attr": "listID"}}},
    {"match": "/*/CreditNoteTypeCode", "as": "metadata", "field": "extra", "key": "inv.type_code", "extra": {"inv.type_code_list": {"attr": "listID"}}},
    {"match": "/*/DocumentCurrencyCode", "as": "metadata", "field": "extra", "key": "inv.currency", "extra": {"inv.currency_list": {"attr": "listID"}}},
    {"match": "/*/TaxCurrencyCode", "as": "metadata", "field": "extra", "key": "inv.tax_currency"},
    {"match": "/*/PricingCurrencyCode", "as": "metadata", "field": "extra", "key": "inv.pricing_currency"},
    {"match": "/*/PaymentCurrencyCode", "as": "metadata", "field": "extra", "key": "inv.payment_currency"},
    {"match": "/*/LineCountNumeric", "as": "metadata", "field": "extra", "key": "inv.line_count"},

    {"match": "/*/cac:InvoiceLine", "as": "row", "rest": 14},
    {"match": "/*/cac:CreditNoteLine", "as": "row", "rest": 14},
    {"match": "cac:InvoiceLine/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:InvoiceLine/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:InvoiceLine/*/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:InvoiceLine/*/*/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:InvoiceLine/*/*/*/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:CreditNoteLine/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:CreditNoteLine/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:CreditNoteLine/*/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:CreditNoteLine/*/*/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:CreditNoteLine/*/*/*/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}, {"attr": "name"}]},
    {"match": "cac:InvoiceLine/ID", "as": "cell", "column": 1, "with": [{"attr": "schemeID"}]},
    {"match": "cac:CreditNoteLine/ID", "as": "cell", "column": 1, "with": [{"attr": "schemeID"}]},
    {"match": "cac:InvoiceLine/cac:Item/Name", "as": "cell", "column": 2},
    {"match": "cac:CreditNoteLine/cac:Item/Name", "as": "cell", "column": 2},
    {"match": "cac:InvoiceLine/cac:Item/Description", "as": "cell", "column": 3},
    {"match": "cac:CreditNoteLine/cac:Item/Description", "as": "cell", "column": 3},
    {"match": "cac:InvoiceLine/InvoicedQuantity", "as": "cell", "column": 4, "with": [{"attr": "unitCode"}]},
    {"match": "cac:CreditNoteLine/CreditedQuantity", "as": "cell", "column": 4, "with": [{"attr": "unitCode"}]},
    {"match": "cac:InvoiceLine/cac:Price/PriceAmount", "as": "cell", "column": 5, "with": [{"attr": "currencyID"}]},
    {"match": "cac:CreditNoteLine/cac:Price/PriceAmount", "as": "cell", "column": 5, "with": [{"attr": "currencyID"}]},
    {"match": "cac:InvoiceLine/cac:Price/BaseQuantity", "as": "cell", "column": 5, "with": [{"attr": "unitCode"}]},
    {"match": "cac:CreditNoteLine/cac:Price/BaseQuantity", "as": "cell", "column": 5, "with": [{"attr": "unitCode"}]},
    {"match": "cac:InvoiceLine/LineExtensionAmount", "as": "cell", "column": 6, "with": [{"attr": "currencyID"}]},
    {"match": "cac:CreditNoteLine/LineExtensionAmount", "as": "cell", "column": 6, "with": [{"attr": "currencyID"}]},
    {"match": "cac:InvoiceLine/cac:Item/cac:ClassifiedTaxCategory/ID", "as": "cell", "column": 7, "with": [{"attr": "schemeID"}]},
    {"match": "cac:CreditNoteLine/cac:Item/cac:ClassifiedTaxCategory/ID", "as": "cell", "column": 7, "with": [{"attr": "schemeID"}]},
    {"match": "cac:InvoiceLine/cac:Item/cac:ClassifiedTaxCategory/Percent", "as": "cell", "column": 8},
    {"match": "cac:CreditNoteLine/cac:Item/cac:ClassifiedTaxCategory/Percent", "as": "cell", "column": 8},
    {"match": "cac:InvoiceLine/Note", "as": "cell", "column": 9, "with": [{"attr": "languageID"}]},
    {"match": "cac:CreditNoteLine/Note", "as": "cell", "column": 9, "with": [{"attr": "languageID"}]},
    {"match": "cac:InvoiceLine/cac:Item/cac:SellersItemIdentification/ID", "as": "cell", "column": 10, "with": [{"attr": "schemeID"}]},
    {"match": "cac:CreditNoteLine/cac:Item/cac:SellersItemIdentification/ID", "as": "cell", "column": 10, "with": [{"attr": "schemeID"}]},
    {"match": "cac:InvoiceLine/cac:Item/cac:BuyersItemIdentification/ID", "as": "cell", "column": 10, "with": [{"attr": "schemeID"}]},
    {"match": "cac:CreditNoteLine/cac:Item/cac:BuyersItemIdentification/ID", "as": "cell", "column": 10, "with": [{"attr": "schemeID"}]},
    {"match": "cac:InvoiceLine/cac:Item/cac:StandardItemIdentification/ID", "as": "cell", "column": 10, "with": [{"attr": "schemeID"}]},
    {"match": "cac:CreditNoteLine/cac:Item/cac:StandardItemIdentification/ID", "as": "cell", "column": 10, "with": [{"attr": "schemeID"}]},
    {"match": "cac:InvoiceLine/cac:Item/cac:CommodityClassification/ItemClassificationCode", "as": "cell", "column": 11, "with": [{"attr": "listID"}, {"attr": "listVersionID"}]},
    {"match": "cac:CreditNoteLine/cac:Item/cac:CommodityClassification/ItemClassificationCode", "as": "cell", "column": 11, "with": [{"attr": "listID"}, {"attr": "listVersionID"}]},
    {"match": "cac:InvoiceLine/cac:Item/cac:AdditionalItemProperty", "as": "cell", "column": 12},
    {"match": "cac:CreditNoteLine/cac:Item/cac:AdditionalItemProperty", "as": "cell", "column": 12},
    {"match": "cac:InvoiceLine/cac:InvoicePeriod", "as": "cell", "column": 13},
    {"match": "cac:CreditNoteLine/cac:InvoicePeriod", "as": "cell", "column": 13},

    {"match": "cac:TaxTotal", "as": "table", "header": ["taxable amount", "tax amount", "VAT category", "VAT rate", "exemption reason code", "exemption reason", "tax scheme", "other"]},
    {"match": "cac:WithholdingTaxTotal", "as": "table", "header": ["taxable amount", "tax amount", "VAT category", "VAT rate", "exemption reason code", "exemption reason", "tax scheme", "other"]},
    {"match": "cac:TaxTotal/TaxAmount", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "TaxTotal/TaxAmount", "inv.currencyID": {"attr": "currencyID"}}},
    {"match": "cac:WithholdingTaxTotal/TaxAmount", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "WithholdingTaxTotal/TaxAmount", "inv.currencyID": {"attr": "currencyID"}}},
    {"match": "cac:TaxTotal/RoundingAmount", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "TaxTotal/RoundingAmount", "inv.currencyID": {"attr": "currencyID"}}},
    {"match": "cac:TaxTotal/TaxEvidenceIndicator", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "TaxTotal/TaxEvidenceIndicator"}},
    {"match": "cac:TaxSubtotal", "as": "row", "rest": 8},
    {"match": "cac:TaxSubtotal/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}]},
    {"match": "cac:TaxSubtotal/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}]},
    {"match": "cac:TaxSubtotal/*/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "unitCode"}, {"attr": "currencyID"}, {"attr": "languageID"}]},
    {"match": "cac:TaxSubtotal/TaxableAmount", "as": "cell", "column": 1, "with": [{"attr": "currencyID"}]},
    {"match": "cac:TaxSubtotal/TaxAmount", "as": "cell", "column": 2, "with": [{"attr": "currencyID"}]},
    {"match": "cac:TaxSubtotal/cac:TaxCategory/ID", "as": "cell", "column": 3, "with": [{"attr": "schemeID"}]},
    {"match": "cac:TaxSubtotal/cac:TaxCategory/Percent", "as": "cell", "column": 4},
    {"match": "cac:TaxSubtotal/cac:TaxCategory/TaxExemptionReasonCode", "as": "cell", "column": 5, "with": [{"attr": "listID"}]},
    {"match": "cac:TaxSubtotal/cac:TaxCategory/TaxExemptionReason", "as": "cell", "column": 6, "with": [{"attr": "languageID"}]},
    {"match": "cac:TaxSubtotal/cac:TaxCategory/cac:TaxScheme/ID", "as": "cell", "column": 7, "with": [{"attr": "schemeID"}]},

    {"match": "/*/cac:AllowanceCharge", "as": "table", "one_row": true, "rest": 9,
      "header": ["charge indicator", "amount", "base amount", "percent", "reason code", "reason", "VAT category", "VAT rate", "other"]},
    {"match": "/*/cac:AllowanceCharge/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "currencyID"}, {"attr": "languageID"}]},
    {"match": "/*/cac:AllowanceCharge/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "currencyID"}, {"attr": "languageID"}]},
    {"match": "/*/cac:AllowanceCharge/*/*/*", "as": "block", "kind": "paragraph", "with": [{"attr": "schemeID"}, {"attr": "listID"}, {"attr": "currencyID"}, {"attr": "languageID"}]},
    {"match": "/*/cac:AllowanceCharge/ChargeIndicator", "as": "cell", "column": 1},
    {"match": "/*/cac:AllowanceCharge/Amount", "as": "cell", "column": 2, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:AllowanceCharge/BaseAmount", "as": "cell", "column": 3, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:AllowanceCharge/MultiplierFactorNumeric", "as": "cell", "column": 4},
    {"match": "/*/cac:AllowanceCharge/AllowanceChargeReasonCode", "as": "cell", "column": 5, "with": [{"attr": "listID"}]},
    {"match": "/*/cac:AllowanceCharge/AllowanceChargeReason", "as": "cell", "column": 6, "with": [{"attr": "languageID"}]},
    {"match": "/*/cac:AllowanceCharge/cac:TaxCategory/ID", "as": "cell", "column": 7, "with": [{"attr": "schemeID"}]},
    {"match": "/*/cac:AllowanceCharge/cac:TaxCategory/Percent", "as": "cell", "column": 8},

    {"match": "/*/cac:LegalMonetaryTotal", "as": "table", "one_row": true, "rest": 9,
      "header": ["line extension amount", "tax exclusive amount", "tax inclusive amount", "allowance total", "charge total", "prepaid", "rounding", "payable", "other"]},
    {"match": "/*/cac:LegalMonetaryTotal/*", "as": "block", "kind": "paragraph", "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:LegalMonetaryTotal/LineExtensionAmount", "as": "cell", "column": 1, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:LegalMonetaryTotal/TaxExclusiveAmount", "as": "cell", "column": 2, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:LegalMonetaryTotal/TaxInclusiveAmount", "as": "cell", "column": 3, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:LegalMonetaryTotal/AllowanceTotalAmount", "as": "cell", "column": 4, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:LegalMonetaryTotal/ChargeTotalAmount", "as": "cell", "column": 5, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:LegalMonetaryTotal/PrepaidAmount", "as": "cell", "column": 6, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:LegalMonetaryTotal/PayableRoundingAmount", "as": "cell", "column": 7, "with": [{"attr": "currencyID"}]},
    {"match": "/*/cac:LegalMonetaryTotal/PayableAmount", "as": "cell", "column": 8, "with": [{"attr": "currencyID"}]},

    {"match": "cac:AccountingSupplierParty", "as": "section", "mark": {"inv.party": "seller"}},
    {"match": "cac:AccountingCustomerParty", "as": "section", "mark": {"inv.party": "buyer"}},
    {"match": "cac:PayeeParty", "as": "section", "mark": {"inv.party": "payee"}},
    {"match": "cac:TaxRepresentativeParty", "as": "section", "mark": {"inv.party": "tax_representative"}},
    {"match": "cac:Delivery", "as": "section", "mark": {"inv.party": "delivery"}},
    {"match": "cac:SellerSupplierParty", "as": "section", "mark": {"inv.party": "seller_supplier"}},
    {"match": "cac:BuyerCustomerParty", "as": "section", "mark": {"inv.party": "buyer_customer"}},
    {"match": "cac:OriginatorCustomerParty", "as": "section", "mark": {"inv.party": "originator"}},
    {"match": "cac:Party", "as": "transparent"},
    {"match": "cac:DeliveryParty", "as": "transparent", "mark": {"inv.group": "DeliveryParty"}},
    {"match": "cac:DeliveryLocation", "as": "transparent", "mark": {"inv.group": "DeliveryLocation"}},
    {"match": "cac:PartyIdentification", "as": "transparent", "mark": {"inv.group": "PartyIdentification"}},
    {"match": "cac:PartyName", "as": "transparent", "mark": {"inv.group": "PartyName"}},
    {"match": "cac:PostalAddress", "as": "transparent", "mark": {"inv.group": "PostalAddress"}},
    {"match": "cac:Address", "as": "transparent", "mark": {"inv.group": "Address"}},
    {"match": "cac:AddressLine", "as": "transparent"},
    {"match": "cac:Country", "as": "transparent"},
    {"match": "cac:PartyTaxScheme", "as": "transparent", "mark": {"inv.group": "PartyTaxScheme"}},
    {"match": "cac:TaxScheme", "as": "transparent"},
    {"match": "cac:PartyLegalEntity", "as": "transparent", "mark": {"inv.group": "PartyLegalEntity"}},
    {"match": "cac:Contact", "as": "transparent", "mark": {"inv.group": "Contact"}},
    {"match": "cac:PaymentMeans", "as": "section", "mark": {"inv.group": "PaymentMeans"}},
    {"match": "cac:PaymentTerms", "as": "section", "mark": {"inv.group": "PaymentTerms"}},
    {"match": "cac:PayeeFinancialAccount", "as": "transparent", "mark": {"inv.account": "PayeeFinancialAccount"}},
    {"match": "cac:PayerFinancialAccount", "as": "transparent", "mark": {"inv.account": "PayerFinancialAccount"}},
    {"match": "cac:FinancialInstitutionBranch", "as": "transparent", "mark": {"inv.account": "FinancialInstitutionBranch"}},
    {"match": "cac:PaymentMandate", "as": "transparent", "mark": {"inv.account": "PaymentMandate"}},
    {"match": "cac:CardAccount", "as": "transparent", "mark": {"inv.account": "CardAccount"}},
    {"match": "cac:AdditionalDocumentReference", "as": "section", "mark": {"inv.group": "AdditionalDocumentReference"}},
    {"match": "cac:OrderReference", "as": "section", "mark": {"inv.group": "OrderReference"}},
    {"match": "cac:BillingReference", "as": "section", "mark": {"inv.group": "BillingReference"}},
    {"match": "cac:InvoiceDocumentReference", "as": "transparent"},
    {"match": "cac:ContractDocumentReference", "as": "section", "mark": {"inv.group": "ContractDocumentReference"}},
    {"match": "cac:DespatchDocumentReference", "as": "section", "mark": {"inv.group": "DespatchDocumentReference"}},
    {"match": "cac:ReceiptDocumentReference", "as": "section", "mark": {"inv.group": "ReceiptDocumentReference"}},
    {"match": "cac:OriginatorDocumentReference", "as": "section", "mark": {"inv.group": "OriginatorDocumentReference"}},
    {"match": "cac:StatementDocumentReference", "as": "section", "mark": {"inv.group": "StatementDocumentReference"}},
    {"match": "cac:ProjectReference", "as": "section", "mark": {"inv.group": "ProjectReference"}},
    {"match": "cac:InvoicePeriod", "as": "section", "mark": {"inv.group": "InvoicePeriod"}},
    {"match": "cac:Attachment", "as": "transparent"},
    {"match": "cac:Attachment/EmbeddedDocumentBinaryObject", "as": "document", "encoding": "base64", "media_type": {"attr": "mimeCode"}, "name": {"attr": "filename"}, "attrs": {"inv.field": "EmbeddedDocumentBinaryObject"}},
    {"match": "cac:ExternalReference", "as": "transparent"},

    {"match": "Note", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "Note", "inv.languageID": {"attr": "languageID"}}},
    {"match": "ID", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "ID", "inv.schemeID": {"attr": "schemeID"}, "inv.schemeAgencyID": {"attr": "schemeAgencyID"}}},
    {"match": "EndpointID", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "EndpointID", "inv.schemeID": {"attr": "schemeID"}}},
    {"match": "CompanyID", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "CompanyID", "inv.schemeID": {"attr": "schemeID"}}},
    {"match": "Name", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "Name"}},
    {"match": "RegistrationName", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "RegistrationName"}},
    {"match": "CompanyLegalForm", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "CompanyLegalForm"}},
    {"match": "StreetName", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "StreetName"}},
    {"match": "AdditionalStreetName", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "AdditionalStreetName"}},
    {"match": "BuildingNumber", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "BuildingNumber"}},
    {"match": "CityName", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "CityName"}},
    {"match": "PostalZone", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "PostalZone"}},
    {"match": "CountrySubentity", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "CountrySubentity"}},
    {"match": "Line", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "AddressLine/Line"}},
    {"match": "IdentificationCode", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "Country/IdentificationCode", "inv.listID": {"attr": "listID"}}},
    {"match": "Telephone", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "Telephone"}},
    {"match": "Telefax", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "Telefax"}},
    {"match": "ElectronicMail", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "ElectronicMail"}},
    {"match": "BuyerReference", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "BuyerReference"}},
    {"match": "AccountingCost", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "AccountingCost"}},
    {"match": "DueDate", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "DueDate"}},
    {"match": "TaxPointDate", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "TaxPointDate"}},
    {"match": "IssueDate", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "IssueDate"}},
    {"match": "StartDate", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "StartDate"}},
    {"match": "EndDate", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "EndDate"}},
    {"match": "DescriptionCode", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "DescriptionCode", "inv.listID": {"attr": "listID"}}},
    {"match": "ActualDeliveryDate", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "ActualDeliveryDate"}},
    {"match": "PaymentMeansCode", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "PaymentMeansCode", "inv.listID": {"attr": "listID"}, "inv.name": {"attr": "name"}}},
    {"match": "PaymentID", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "PaymentID"}},
    {"match": "InstructionID", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "InstructionID"}},
    {"match": "InstructionNote", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "InstructionNote"}},
    {"match": "PaymentDueDate", "as": "block", "kind": "paragraph", "attrs": {"inv.field": "PaymentDueDate"}},
