{
  "profile": "cda",
  "title": "HL7 CDA Release 2 clinical documents (ClinicalDocument, urn:hl7-org:v3), including C-CDA",
  "format": 1,
  "namespaces": {"v3": "urn:hl7-org:v3", "sdtc": "urn:hl7-org:sdtc"},
  "default_namespace": "urn:hl7-org:v3",
  "match": [
    {"root": "ClinicalDocument", "namespace": "urn:hl7-org:v3"}
  ],
  "heading_base": 2,
  "rules": [
    {"match": "/ClinicalDocument", "as": "transparent", "extra": {"cda.class_code": {"attr": "classCode"}, "cda.mood_code": {"attr": "moodCode"}}},
    {"match": "/ClinicalDocument/realmCode", "as": "transparent", "extra": {"cda.realm": {"attr": "code"}}},
    {"match": "/ClinicalDocument/typeId", "as": "transparent", "extra": {"cda.type_id_root": {"attr": "root"}, "cda.type_id_extension": {"attr": "extension"}}},
    {"match": "/ClinicalDocument/templateId", "as": "transparent", "extra": {"cda.template_id": {"attr": "root"}, "cda.template_extension": {"attr": "extension"}}},
    {"match": "/ClinicalDocument/id", "as": "transparent", "extra": {"cda.id_root": {"attr": "root"}, "cda.id_extension": {"attr": "extension"}, "cda.id_authority": {"attr": "assigningAuthorityName"}}},
    {"match": "/ClinicalDocument/code", "as": "transparent", "extra": {"cda.code": {"attr": "code"}, "cda.code_system": {"attr": "codeSystem"}, "cda.code_system_name": {"attr": "codeSystemName"}, "cda.code_display": {"attr": "displayName"}}},
    {"match": "/ClinicalDocument/code/translation", "as": "transparent", "extra": {"cda.code_translation": {"attr": "code"}, "cda.code_translation_system": {"attr": "codeSystem"}, "cda.code_translation_display": {"attr": "displayName"}}},
    {"match": "/ClinicalDocument/code/originalText", "as": "metadata", "field": "extra", "key": "cda.code_original_text"},
    {"match": "/ClinicalDocument/title", "as": "metadata", "field": "title", "also_heading": 1},
    {"match": "/ClinicalDocument/effectiveTime", "as": "transparent", "extra": {"cda.effective_time": {"attr": "value"}}},
    {"match": "/ClinicalDocument/confidentialityCode", "as": "transparent", "extra": {"cda.confidentiality": {"attr": "code"}, "cda.confidentiality_system": {"attr": "codeSystem"}, "cda.confidentiality_display": {"attr": "displayName"}}},
    {"match": "/ClinicalDocument/languageCode", "as": "metadata", "field": "language", "value": {"attr": "code"}},
    {"match": "/ClinicalDocument/setId", "as": "transparent", "extra": {"cda.set_id_root": {"attr": "root"}, "cda.set_id_extension": {"attr": "extension"}}},
    {"match": "/ClinicalDocument/versionNumber", "as": "transparent", "extra": {"cda.version": {"attr": "value"}}},
    {"match": "/ClinicalDocument/copyTime", "as": "transparent", "extra": {"cda.copy_time": {"attr": "value"}}},
    {"match": "/ClinicalDocument/recordTarget", "as": "metadata", "field": "extra", "key": "cda.record_target", "join": "; "},
    {"match": "/ClinicalDocument/author", "as": "metadata", "field": "extra", "key": "cda.author", "join": "; "},
    {"match": "/ClinicalDocument/dataEnterer", "as": "metadata", "field": "extra", "key": "cda.data_enterer", "join": "; "},
    {"match": "/ClinicalDocument/informant", "as": "metadata", "field": "extra", "key": "cda.informant", "join": "; "},
    {"match": "/ClinicalDocument/custodian", "as": "metadata", "field": "extra", "key": "cda.custodian", "join": "; "},
    {"match": "/ClinicalDocument/informationRecipient", "as": "metadata", "field": "extra", "key": "cda.information_recipient", "join": "; "},
    {"match": "/ClinicalDocument/legalAuthenticator", "as": "metadata", "field": "extra", "key": "cda.legal_authenticator", "join": "; "},
    {"match": "/ClinicalDocument/authenticator", "as": "metadata", "field": "extra", "key": "cda.authenticator", "join": "; "},
    {"match": "/ClinicalDocument/participant", "as": "metadata", "field": "extra", "key": "cda.participant", "join": "; ", "extra": {"cda.participant_type": {"attr": "typeCode"}}},
    {"match": "/ClinicalDocument/inFulfillmentOf", "as": "metadata", "field": "extra", "key": "cda.in_fulfillment_of", "join": "; "},
    {"match": "/ClinicalDocument/documentationOf", "as": "metadata", "field": "extra", "key": "cda.documentation_of", "join": "; "},
    {"match": "/ClinicalDocument/relatedDocument", "as": "metadata", "field": "extra", "key": "cda.related_document", "join": "; ", "extra": {"cda.related_document_type": {"attr": "typeCode"}}},
    {"match": "/ClinicalDocument/authorization", "as": "metadata", "field": "extra", "key": "cda.authorization", "join": "; "},
    {"match": "/ClinicalDocument/componentOf", "as": "metadata", "field": "extra", "key": "cda.component_of", "join": "; "},

    {"match": "/ClinicalDocument/component", "as": "transparent"},
    {"match": "structuredBody", "as": "transparent"},
    {"match": "structuredBody/component", "as": "transparent"},
    {"match": "section/component", "as": "transparent"},
    {"match": "section", "as": "section", "anchor": {"attr": "ID"}},
    {"match": "section/templateId", "as": "note", "type": "attribute", "value": {"attr": "root"}, "attrs": {"cda.field": "templateId", "cda.extension": {"attr": "extension"}}},
    {"match": "section/id", "as": "note", "type": "attribute", "value": {"attr": "root"}, "attrs": {"cda.field": "id", "cda.extension": {"attr": "extension"}}},
    {"match": "section/code", "as": "note", "type": "attribute", "value": {"attr": "displayName"}, "attrs": {"cda.field": "code", "cda.code": {"attr": "code"}, "cda.code_system": {"attr": "codeSystem"}, "cda.code_system_name": {"attr": "codeSystemName"}}},
    {"match": "section/title", "as": "heading", "level": "nesting"},
    {"match": "section/text", "as": "transparent", "anchor": {"attr": "ID"}, "mark": {"cda.part": "narrative"}},
    {"match": "section/confidentialityCode", "as": "note", "type": "attribute", "value": {"attr": "code"}, "attrs": {"cda.field": "confidentialityCode"}},
    {"match": "section/languageCode", "as": "note", "type": "attribute", "value": {"attr": "code"}, "attrs": {"cda.field": "languageCode"}},
    {"match": "section/author", "as": "metadata", "field": "extra", "key": "cda.section_author", "join": "; "},
    {"match": "section/informant", "as": "metadata", "field": "extra", "key": "cda.section_informant", "join": "; "},
    {"match": "section/subject", "as": "metadata", "field": "extra", "key": "cda.section_subject", "join": "; "},
    {"match": "section/entry", "as": "transparent", "mark": {"cda.part": "entry", "cda.entry_type": {"attr": "typeCode"}}},

    {"match": "paragraph", "as": "block", "kind": "paragraph", "anchor": {"attr": "ID"}, "attrs": {"cda.style": {"attr": "styleCode"}}},
    {"match": "paragraph/caption", "as": "label"},
    {"match": "list", "as": "list", "ordered": {"attr": "listType", "in": ["ordered"]}, "anchor": {"attr": "ID"}, "attrs": {"cda.style": {"attr": "styleCode"}}},
    {"match": "list/caption", "as": "block", "kind": "caption"},
    {"match": "list/item", "as": "item", "anchor": {"attr": "ID"}},
    {"match": "item/caption", "as": "label"},
    {"match": "table", "as": "table", "anchor": {"attr": "ID"}, "attrs": {"cda.border": {"attr": "border"}, "cda.width": {"attr": "width"}, "cda.style": {"attr": "styleCode"}}},
    {"match": "table/caption", "as": "block", "kind": "caption"},
    {"match": "colgroup", "as": "transparent"},
    {"match": "col", "as": "transparent"},
    {"match": "thead", "as": "transparent"},
    {"match": "tbody", "as": "transparent"},
    {"match": "tfoot", "as": "transparent"},
    {"match": "tr", "as": "row"},
    {"match": "thead/tr", "as": "row", "header": true},
    {"match": "th", "as": "cell", "header": true, "colspan": "colspan", "rowspan": "rowspan"},
    {"match": "td", "as": "cell", "colspan": "colspan", "rowspan": "rowspan"},
    {"match": "content", "as": "inline"},
    {"match": "content[@ID]", "as": "inline", "attrs": {"cda.id": {"attr": "ID"}}},
    {"match": "content[@styleCode~='Bold']", "as": "inline", "style": "bold"},
    {"match": "content[@styleCode~='Italics']", "as": "inline", "style": "italic"},
    {"match": "content[@revised='delete']", "as": "inline", "attrs": {"cda.revised": "delete"}},
    {"match": "sub", "as": "inline", "style": "subscript"},
    {"match": "sup", "as": "inline", "style": "superscript"},
    {"match": "br", "as": "break"},
    {"match": "linkHtml", "as": "inline", "link": {"attr": "href"}, "attrs": {"cda.title": {"attr": "title"}}},
    {"match": "footnote", "as": "block", "split": true, "kind": "footnote", "anchor": {"attr": "ID"}},
    {"match": "footnoteRef", "as": "inline", "style": "superscript", "link": {"attr": "IDREF"}},
    {"match": "renderMultiMedia", "as": "image", "id": {"attr": "referencedObject"}, "alt": {"child": "caption"}, "anchor": {"attr": "ID"}},

    {"match": "nonXMLBody", "as": "transparent", "extra": {"cda.body": "nonXMLBody"}},
    {"match": "nonXMLBody/text", "as": "stored", "kind": "custom_xml", "extra": {"cda.nonxml_media_type": {"attr": "mediaType"}, "cda.nonxml_representation": {"attr": "representation"}, "cda.nonxml_compression": {"attr": "compression"}}},
    {"match": "nonXMLBody/languageCode", "as": "transparent", "extra": {"cda.nonxml_language": {"attr": "code"}}}
  ]
}
