{
  "profile": "dila-juri",
  "title": "DILA case law exports (JADE, CASS, INCA, CAPP, CONSTIT): court decisions",
  "format": 1,
  "match": [
    {"root": "TEXTE_JURI_JUDI"}, {"root": "TEXTE_JURI_ADMIN"}, {"root": "TEXTE_JURI_CONSTIT"}
  ],
  "heading_base": 2,
  "rules": [
    {"match": "/TEXTE_JURI_JUDI", "as": "transparent", "anchor": {"child": "META/META_COMMUN/ID"}, "extra": {"juri.root": "TEXTE_JURI_JUDI", "juri.id": {"child": "META/META_COMMUN/ID"}}},
    {"match": "/TEXTE_JURI_ADMIN", "as": "transparent", "anchor": {"child": "META/META_COMMUN/ID"}, "extra": {"juri.root": "TEXTE_JURI_ADMIN", "juri.id": {"child": "META/META_COMMUN/ID"}}},
    {"match": "/TEXTE_JURI_CONSTIT", "as": "transparent", "anchor": {"child": "META/META_COMMUN/ID"}, "extra": {"juri.root": "TEXTE_JURI_CONSTIT", "juri.id": {"child": "META/META_COMMUN/ID"}}},
    {"match": "META", "as": "transparent"},
    {"match": "META_COMMUN", "as": "transparent"},
    {"match": "META_SPEC", "as": "transparent"},
    {"match": "META_JURI", "as": "transparent"},
    {"match": "META_JURI_JUDI", "as": "transparent"},
    {"match": "META_JURI_ADMIN", "as": "transparent"},
    {"match": "META_JURI_CONSTIT", "as": "transparent"},
    {"match": "ID", "as": "metadata", "field": "extra", "key": "juri.id"},
    {"match": "ANCIEN_ID", "as": "metadata", "field": "extra", "key": "juri.ancien_id"},
    {"match": "ORIGINE", "as": "metadata", "field": "extra", "key": "juri.origine"},
    {"match": "URL", "as": "metadata", "field": "extra", "key": "juri.url"},
    {"match": "NATURE", "as": "metadata", "field": "extra", "key": "juri.nature"},
    {"match": "META_JURI/TITRE", "as": "metadata", "field": "title", "also_heading": 1},
    {"match": "DATE_DEC", "as": "metadata", "field": "created"},
    {"match": "JURIDICTION", "as": "metadata", "field": "extra", "key": "juri.juridiction"},
    {"match": "NUMERO", "as": "metadata", "field": "extra", "key": "juri.numero"},
    {"match": "SOLUTION", "as": "metadata", "field": "extra", "key": "juri.solution"},
    {"match": "ECLI", "as": "metadata", "field": "extra", "key": "juri.ecli"},
    {"match": "FORMATION", "as": "metadata", "field": "extra", "key": "juri.formation"},
    {"match": "NUMEROS_AFFAIRES", "as": "transparent"},
    {"match": "NUMERO_AFFAIRE", "as": "metadata", "field": "extra", "key": "juri.numero_affaire"},
    {"match": "PUBLI_BULL", "as": "metadata", "field": "extra", "key": "juri.publi_bull", "extra": {"juri.publi_bull_publie": {"attr": "publie"}}},
    {"match": "FORM_DEC_ATT", "as": "metadata", "field": "extra", "key": "juri.form_dec_att"},
    {"match": "DATE_DEC_ATT", "as": "metadata", "field": "extra", "key": "juri.date_dec_att"},
    {"match": "SIEGE_APPEL", "as": "metadata", "field": "extra", "key": "juri.siege_appel"},
    {"match": "JURI_PREM", "as": "metadata", "field": "extra", "key": "juri.juri_prem"},
    {"match": "LIEU_PREM", "as": "metadata", "field": "extra", "key": "juri.lieu_prem"},
    {"match": "DEMANDEUR", "as": "metadata", "field": "extra", "key": "juri.demandeur"},
    {"match": "DEFENDEUR", "as": "metadata", "field": "extra", "key": "juri.defendeur"},
    {"match": "PRESIDENT", "as": "metadata", "field": "extra", "key": "juri.president"},
    {"match": "AVOCAT_GL", "as": "metadata", "field": "extra", "key": "juri.avocat_gl"},
    {"match": "AVOCATS", "as": "metadata", "field": "extra", "key": "juri.avocats"},
    {"match": "RAPPORTEUR", "as": "metadata", "field": "extra", "key": "juri.rapporteur"},
    {"match": "COMMISSAIRE_GVT", "as": "metadata", "field": "extra", "key": "juri.commissaire_gvt"},
    {"match": "PUBLI_RECUEIL", "as": "metadata", "field": "extra", "key": "juri.publi_recueil"},
    {"match": "TYPE_REC", "as": "metadata", "field": "extra", "key": "juri.type_rec"},
    {"match": "NOR", "as": "metadata", "field": "extra", "key": "juri.nor"},
    {"match": "NATURE_QUALIFIEE", "as": "metadata", "field": "extra", "key": "juri.nature_qualifiee"},
    {"match": "LOI_DEF", "as": "metadata", "field": "extra", "key": "juri.loi_def", "extra": {"juri.loi_def_date": {"attr": "date"}, "juri.loi_def_nor": {"attr": "nor"}, "juri.loi_def_num": {"attr": "num"}}},
    {"match": "TITRE_JO", "as": "metadata", "field": "extra", "key": "juri.titre_jo"},
    {"match": "URL_CC", "as": "metadata", "field": "extra", "key": "juri.url_cc"},
    {"match": "TEXTE", "as": "transparent"},
    {"match": "BLOC_TEXTUEL", "as": "transparent", "mark": {"juri.field": "BLOC_TEXTUEL"}},
    {"match": "SOMMAIRE", "as": "transparent", "mark": {"juri.field": "SOMMAIRE"}},
    {"match": "SCT", "as": "block", "kind": "paragraph", "attrs": {"juri.part": "SCT", "juri.id": {"attr": "ID"}, "juri.type": {"attr": "TYPE"}}},
    {"match": "ANA", "as": "block", "kind": "paragraph", "attrs": {"juri.part": "ANA", "juri.id": {"attr": "ID"}}},
    {"match": "CITATION_JP", "as": "transparent", "mark": {"juri.field": "CITATION_JP"}},
    {"match": "SAISINES", "as": "transparent", "mark": {"juri.field": "SAISINES"}},
    {"match": "OBSERVATIONS", "as": "transparent", "mark": {"juri.field": "OBSERVATIONS"}},
    {"match": "LIENS", "as": "transparent", "mark": {"juri.group": "LIENS"}},
    {"match": "LIEN", "as": "block", "kind": "paragraph", "attrs": {"juri.typelien": {"attr": "typelien"}, "juri.sens": {"attr": "sens"}, "juri.id": {"attr": "id"}, "juri.cidtexte": {"attr": "cidtexte"}, "juri.naturetexte": {"attr": "naturetexte"}, "juri.num": {"attr": "num"}, "juri.numtexte": {"attr": "numtexte"}, "juri.nortexte": {"attr": "nortexte"}, "juri.datesignatexte": {"attr": "datesignatexte"}}},
    {"match": "CONTENU", "as": "transparent"},
    {"match": "div", "as": "transparent", "attrs": {"juri.align": {"attr": "align"}}},
    {"match": "p", "as": "block", "kind": "paragraph", "attrs": {"juri.align": {"attr": "align"}}},
    {"match": "br", "as": "break"},
    {"match": "blockquote", "as": "block", "kind": "quote"},
    {"match": "table", "as": "table", "attrs": {"juri.border": {"attr": "border"}, "juri.align": {"attr": "align"}}},
    {"match": "tbody", "as": "transparent"},
    {"match": "thead", "as": "transparent"},
    {"match": "tfoot", "as": "transparent"},
    {"match": "colgroup", "as": "transparent"},
    {"match": "col", "as": "transparent"},
    {"match": "tr", "as": "row"},
    {"match": "thead/tr", "as": "row", "header": true},
    {"match": "th", "as": "cell", "header": true, "colspan": "colspan", "rowspan": "rowspan"},
    {"match": "td", "as": "cell", "colspan": "colspan", "rowspan": "rowspan"},
    {"match": "ul", "as": "list", "ordered": false},
    {"match": "ol", "as": "list", "ordered": true},
    {"match": "li", "as": "item"},
    {"match": "sup", "as": "inline", "style": "superscript"},
    {"match": "sub", "as": "inline", "style": "subscript"},
    {"match": "b", "as": "inline", "style": "bold"},
    {"match": "strong", "as": "inline", "style": "bold"},
    {"match": "i", "as": "inline", "style": "italic"},
    {"match": "em", "as": "inline", "style": "italic"},
    {"match": "u", "as": "inline"},
    {"match": "font", "as": "inline"},
    {"match": "span", "as": "inline"},
    {"match": "a", "as": "inline", "link": {"attr": "href"}}
  ]
}
